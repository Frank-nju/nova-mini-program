/* === 事件云图页面 === */
.cloudmap-container {
  width: 100%;
  height: 100vh;
  background: #0a0a0f;
  position: relative;
  display: flex;
  flex-direction: column;
  z-index: 100;
}

/* === 顶部导航栏 === */
.cloudmap-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: rgba(10, 10, 15, 0.95);
  border-bottom: 2rpx solid rgba(100, 200, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 110;
  backdrop-filter: blur(20px);
  box-shadow: 0 0 30rpx rgba(100, 200, 255, 0.15);
}

.header-left {
  color: #64c8ff;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.header-left:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.header-title {
  color: #f0ede6;
  font-size: 32rpx;
  font-weight: 300;
  letter-spacing: 2rpx;
  flex: 1;
  text-align: center;
}

.header-right {
  width: 60rpx;
}

/* === Canvas画布 === */
.cloud-canvas {
  flex: 1;
  margin-top: 80rpx;
  background: radial-gradient(ellipse at 30% 30%, rgba(100, 200, 255, 0.05), transparent 50%),
              radial-gradient(ellipse at 70% 70%, rgba(255, 105, 180, 0.03), transparent 50%);
}

/* === 图例 === */
.cloud-legend {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 40rpx;
  padding: 20rpx 40rpx;
  background: rgba(10, 10, 15, 0.9);
  border: 1rpx solid rgba(100, 200, 255, 0.2);
  border-radius: 30rpx;
  backdrop-filter: blur(20px);
  z-index: 105;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #9a9aaa;
  letter-spacing: 1rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot.unlocked {
  background: #64c8ff;
  box-shadow: 0 0 12rpx rgba(100, 200, 255, 0.6);
}

.legend-dot.locked {
  background: rgba(100, 100, 120, 0.4);
  border: 1rpx solid rgba(100, 100, 120, 0.5);
}

/* === 事件详情浮窗 === */
.event-detail-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 200;
  animation: popupEnter 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes popupEnter {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.popup-content {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15), rgba(201, 169, 110, 0.05));
  border: 1rpx solid rgba(201, 169, 110, 0.3);
  border-radius: 16rpx;
  padding: 40rpx;
  min-width: 300rpx;
  text-align: center;
  backdrop-filter: blur(20px);
  box-shadow: 0 0 60rpx rgba(201, 169, 110, 0.15), 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.popup-title {
  font-size: 32rpx;
  color: #f0ede6;
  font-weight: 500;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.popup-section {
  font-size: 20rpx;
  color: #9a9aaa;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.popup-status {
  display: flex;
  justify-content: center;
}

.status-badge {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #0a0a0f;
  font-weight: 600;
  letter-spacing: 1rpx;
}
