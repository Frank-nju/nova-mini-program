<view class="exhibit-container">
  <!-- 顶部返回按钮 -->
  <view class="top-bar">
    <view class="btn-back" bindtap="goBack">
      <text>← 返回</text>
    </view>
  </view>

  <!-- 六部分卷轴区域 -->
  <scroll-view class="sections-scroll" scroll-y="{{true}}"
               bindscroll="onScroll"
               style="height: {{screenHeight}}px">
    
    <!-- 第一部分：首页（追光封面） -->
    <view class="section section-1" id="section-0">
      <!-- 背景图片 -->
      <image wx:if="{{pageImages['首页']}}" src="{{pageImages['首页']}}" class="section-bg-image {{activeStates[0] ? 'active' : ''}}" mode="aspectFill"></image>

      <!-- 封面文字层 -->
      <view class="cover-text-layer">
        <view class="cover-title-wrap">
          <text class="cover-title reveal {{activeStates[0] ? 'visible' : ''}} reveal-delay-1">追光</text>
          <view class="cover-title-line reveal {{activeStates[0] ? 'visible' : ''}} reveal-delay-2"></view>
          <text class="cover-subtitle reveal {{activeStates[0] ? 'visible' : ''}} reveal-delay-3">吴健雄传</text>
        </view>
      </view>

      <!-- 向下滑动提示 -->
      <view class="scroll-hint-bottom">
        <view class="scroll-hint-arrow-down"></view>
        <text class="scroll-hint-text">向下滑动探索</text>
      </view>
    </view>

    <!-- 第二部分：序章 · 西学求索 -->
    <view class="section section-2" id="section-1">
      <!-- 背景图片 -->
      <image src="{{pageImages['序章'] || '/pages/image/序章.jpg'}}" class="section-bg-image {{activeStates[1] ? 'active' : ''}}" mode="aspectFill"></image>

      <!-- 书本叠加层 - 位置在图片底部中央 -->
      <view class="scroll-overlay scroll-overlay-1" bindtap="enterStory" data-section="1">
        <view class="scroll-glow-aura"></view>
        <text class="scroll-label">点击书本</text>
        <text class="scroll-label-sub">以继续</text>
      </view>

      <!-- 内容（可选，放在顶部） -->
      <view class="section-content">
        <view class="scene-title scene-title-1">序章</view>
      </view>

      <!-- 向下滑动提示 -->
      <view class="scroll-hint-bottom">
        <view class="scroll-hint-arrow-down"></view>
        <text class="scroll-hint-text">向下滑动探索</text>
      </view>
    </view>

    <!-- 第三部分：生平履历 · 孤行远方 -->
    <view class="section section-3" id="section-2">
      <!-- 背景图片 -->
      <image src="{{pageImages['生平履历'] || '/pages/image/生平履历.jpg'}}" class="section-bg-image {{activeStates[2] ? 'active' : ''}}" mode="aspectFill"></image>

      <!-- 书本叠加层 - 位置在图片底部中央 -->
      <view class="scroll-overlay scroll-overlay-2" bindtap="enterStory" data-section="2">
        <view class="scroll-glow-aura"></view>
        <text class="scroll-label">点击书本</text>
        <text class="scroll-label-sub">以继续</text>
      </view>

      <!-- 内容（可选，放在顶部） -->
      <view class="section-content">
        <view class="scene-title scene-title-2">生平履历</view>
      </view>

      <!-- 向下滑动提示 -->
      <view class="scroll-hint-bottom">
        <view class="scroll-hint-arrow-down"></view>
        <text class="scroll-hint-text">向下滑动探索</text>
      </view>
    </view>

    <!-- 第四部分：治学风骨 · 严谨之光 -->
    <view class="section section-4" id="section-3">
      <!-- 背景图片 -->
      <image src="{{pageImages['治学风骨'] || '/pages/image/治学风骨.jpg'}}" class="section-bg-image {{activeStates[3] ? 'active' : ''}}" mode="aspectFill"></image>

      <!-- 书本叠加层 - 位置在图片底部中央 -->
      <view class="scroll-overlay scroll-overlay-3" bindtap="enterStory" data-section="3">
        <view class="scroll-glow-aura"></view>
        <text class="scroll-label">点击书本</text>
        <text class="scroll-label-sub">以继续</text>
      </view>

      <!-- 内容（可选，放在顶部） -->
      <view class="section-content">
        <view class="scene-title scene-title-3">治学风骨</view>
      </view>

      <!-- 向下滑动提示 -->
      <view class="scroll-hint-bottom">
        <view class="scroll-hint-arrow-down"></view>
        <text class="scroll-hint-text">向下滑动探索</text>
      </view>
    </view>

    <!-- 第五部分：科研丰碑 · 宇称不守恒 -->
    <view class="section section-5" id="section-4">
      <!-- 背景图片 -->
      <image src="{{pageImages['科研丰碑'] || '/pages/image/科研丰碑.jpg'}}" class="section-bg-image {{activeStates[4] ? 'active' : ''}}" mode="aspectFill"></image>

      <!-- 书本叠加层 - 位置在图片底部中央 -->
      <view class="scroll-overlay scroll-overlay-4" bindtap="enterStory" data-section="4">
        <view class="scroll-glow-aura"></view>
        <text class="scroll-label">点击书本</text>
        <text class="scroll-label-sub">以继续</text>
      </view>

      <!-- 内容（可选，放在顶部） -->
      <view class="section-content">
        <view class="scene-title scene-title-4">科研丰碑</view>
      </view>

      <!-- 向下滑动提示 -->
      <view class="scroll-hint-bottom">
        <view class="scroll-hint-arrow-down"></view>
        <text class="scroll-hint-text">向下滑动探索</text>
      </view>
    </view>

    <!-- 第六部分：尾声 · 荣耀归来 -->
    <view class="section section-6" id="section-5">
      <!-- 背景图片 -->
      <image src="{{pageImages['尾声'] || '/pages/image/尾声.jpg'}}" class="section-bg-image {{activeStates[5] ? 'active' : ''}}" mode="aspectFill"></image>

      <!-- 书本叠加层 - 位置在图片底部中央 -->
      <view class="scroll-overlay scroll-overlay-5" bindtap="enterStory" data-section="5">
        <view class="scroll-glow-aura"></view>
        <text class="scroll-label">点击书本</text>
        <text class="scroll-label-sub">以继续</text>
      </view>

      <!-- 内容（可选，放在顶部） -->
      <view class="section-content">
        <view class="scene-title scene-title-5">尾声</view>
      </view>

      <!-- 向下滑动提示 -->
      <view class="scroll-hint-bottom">
        <view class="scroll-hint-arrow-down"></view>
        <text class="scroll-hint-text">向下滑动探索</text>
      </view>
    </view>

    <!-- 第七部分：致敬墙 · 传承 -->
    <view class="section section-7" id="section-6">

      <!-- ===== 致敬墙区域 ===== -->
      <view class="tribute-section {{activeStates[6] ? 'active' : ''}}">

        <!-- 顶部装饰 -->
        <view class="tribute-deco-top">
          <view class="tribute-deco-line"></view>
          <view class="tribute-deco-diamond"></view>
          <view class="tribute-deco-line"></view>
        </view>

        <view class="tribute-header">
          <text class="tribute-title">致敬墙</text>
          <view class="tribute-line"></view>
          <text class="tribute-sub">物理学界的评价</text>
        </view>

        <view wx:for="{{tributeQuotes}}" wx:key="index" class="tribute-card {{activeStates[6] ? 'card-visible' : ''}}" style="animation-delay: {{index * 0.15}}s">
          <!-- 卡片左侧金线 -->
          <view class="tribute-card-accent"></view>
          <!-- 装饰角标 -->
          <view class="tribute-card-corner"></view>
          <view class="tribute-card-body">
            <view class="tribute-quote-main">
              <view class="tribute-quote-mark">"</view>
              <text class="tribute-quote-text">{{item.quote}}</text>
            </view>
            <view class="tribute-author">
              <view class="tribute-author-avatar">{{item.icon}}</view>
              <view class="tribute-author-info">
                <text class="tribute-author-name">{{item.author}}</text>
                <text class="tribute-author-role">{{item.role}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 中部过渡装饰 -->
        <view class="tribute-divider">
          <view class="tribute-divider-line"></view>
          <view class="tribute-divider-star">✦</view>
          <view class="tribute-divider-line"></view>
        </view>
      </view>

      <!-- ===== 用户致敬留言区域 ===== -->
      <view class="user-tribute-section {{activeStates[6] ? 'active' : ''}}">

        <view class="user-tribute-header">
          <text class="user-tribute-title">你的致敬</text>
          <view class="user-tribute-header-line"></view>
          <text class="user-tribute-sub">留下你对吴健雄先生的致敬与感言</text>
        </view>

        <view class="tribute-input-card {{tributeInputFocused ? 'input-focused' : ''}}">
          <textarea
            class="tribute-textarea"
            value="{{tributeInputValue}}"
            placeholder="写下你想对吴健雄先生说的话…"
            placeholder-class="tribute-placeholder"
            maxlength="500"
            auto-height
            bindinput="onTributeInput"
            bindfocus="onTributeFocus"
            bindblur="onTributeBlur"
            disabled="{{tributeSubmitting}}"
          />
          <view class="tribute-input-footer">
            <text class="tribute-char-count">{{tributeInputValue.length || 0}}/500</text>
            <button
              class="tribute-submit-btn {{tributeSubmitting ? 'btn-disabled' : ''}} {{tributeInputValue.trim().length > 0 ? 'btn-active' : ''}}"
              bindtap="submitTribute"
              disabled="{{tributeSubmitting || tributeInputValue.trim().length === 0}}"
              loading="{{tributeSubmitting}}"
            >
              {{tributeSubmitting ? '提交中...' : '致敬'}}
            </button>
          </view>
        </view>

        <view wx:if="{{userTributes.length > 0}}" class="user-tribute-list">
          <view
            wx:for="{{tributePreviewList}}"
            wx:key="_id"
            class="user-tribute-card {{activeStates[6] ? 'card-visible' : ''}}"
            style="animation-delay: {{index * 0.08}}s"
          >
            <view class="user-tribute-card-body">
              <view class="user-tribute-card-top">
                <view class="user-tribute-avatar">
                  <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="user-tribute-avatar-img" />
                  <text wx:else class="user-tribute-avatar-text">👤</text>
                </view>
                <view class="user-tribute-meta">
                  <text class="user-tribute-nickname">{{item.nickname}}</text>
                  <text class="user-tribute-time">{{item.createdAt}}</text>
                </view>
              </view>
              <text class="user-tribute-message">{{item.message}}</text>
            </view>
          </view>

          <view wx:if="{{userTributes.length > 3}}" class="user-tribute-view-all" bindtap="openTributePanel">
            <text>查看全部 {{userTributes.length}} 条致敬</text>
            <text class="user-tribute-view-all-arrow">›</text>
          </view>
        </view>

        <view wx:if="{{userTributes.length === 0 && !tributeLoading}}" class="user-tribute-empty">
          <text>还没有人留言，成为第一个致敬的人吧</text>
        </view>

      </view>

      <!-- ===== 传承时间线区域 ===== -->
      <view class="legacy-section {{activeStates[6] ? 'active' : ''}}">

        <view class="legacy-header">
          <text class="legacy-title">传承</text>
          <view class="legacy-line"></view>
          <text class="legacy-sub">精神不朽，薪火相传</text>
        </view>

        <view class="legacy-timeline">
          <view class="legacy-line-bar"></view>
          <view wx:for="{{legacyTimeline}}" wx:key="index" class="legacy-item {{activeStates[6] ? 'item-visible' : ''}}" style="animation-delay: {{index * 0.12}}s">
            <view class="legacy-dot-wrap">
              <view class="legacy-dot"></view>
              <view class="legacy-dot-ring"></view>
            </view>
            <view class="legacy-card">
              <view class="legacy-year-badge">{{item.year}}</view>
              <view class="legacy-card-title">{{item.title}}</view>
              <view class="legacy-desc"><text>{{item.desc}}</text></view>
            </view>
          </view>
          <!-- 时间线底部收口 -->
          <view class="legacy-timeline-end">
            <view class="legacy-end-dot"></view>
          </view>
        </view>
      </view>

      <!-- ===== 底部终语 ===== -->
      <view class="final-words {{activeStates[6] ? 'active' : ''}}">
        <view class="final-deco">
          <view class="final-deco-line"></view>
          <view class="final-deco-star">✦</view>
          <view class="final-deco-line"></view>
        </view>
        <text class="final-text">追光不息，精神永存</text>
        <view class="final-sub-text">—— 致敬每一位在科学道路上前行的探索者 ——</view>
      </view>
    </view>

  </scroll-view>

  <!-- 常驻按钮栏（右侧浮窗） -->
  <view class="floating-buttons">
    <view class="float-btn btn-clouds" bindtap="toggleClouds" title="事件云图">
      <text>☁</text>
    </view>
    <view class="float-btn btn-badge" bindtap="toggleBadge" title="徽章成就">
      <text>★</text>
      <view wx:if="{{newBadges}}" class="badge-dot"></view>
    </view>
    <view class="float-btn btn-materials" bindtap="toggleMaterials" title="素材展示">
      <text>📁</text>
    </view>
    <view class="float-btn btn-ai" bindtap="toggleAI" title="数字人">
      <text>🤖</text>
    </view>
    <view class="float-btn btn-quiz" bindtap="toggleQuiz" title="知识问答">
      <text>📝</text>
    </view>
  </view>

  <!-- 徽章弹出通知 -->
  <view wx:if="{{badgeNotification}}" class="badge-notification" style="animation: badge-popup 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards">
    <view class="notification-content">
      <view class="notification-icon">🏆</view>
      <view class="notification-text">
        <view class="notification-title">成就解锁</view>
        <view class="notification-name">{{badgeNotification.name}}</view>
      </view>
    </view>
  </view>

  <!-- 故事完成通知 -->
  <view wx:if="{{storyCompleteNotification}}" class="story-complete-toast" style="animation: storyCompletePop 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards">
    <view class="story-complete-icon">✓</view>
    <view class="story-complete-title">{{storyCompleteNotification.title}}</view>
    <view class="story-complete-text">{{storyCompleteNotification.text}}</view>
  </view>

  <!-- 徽章成就面板 -->
  <view wx:if="{{showBadgePanel}}" class="panel badge-panel">
    <view class="panel-header">
      <text class="panel-title">徽章成就</text>
      <view class="close-btn" bindtap="toggleBadge">✕</view>
    </view>
    <view class="badges-container">
      <view class="badge-item" wx:for="{{badges}}" wx:key="id"
            style="opacity: {{item.unlocked ? 1 : 0.3}}"
            bindtap="onBadgeTap" data-index="{{index}}">
        <text class="badge-icon">{{item.icon}}</text>
        <text class="badge-name">{{item.name}}</text>
      </view>
    </view>
    <view class="badge-reset-wrap">
      <view class="badge-reset-btn" bindtap="resetBadges">
        <text>重置进度</text>
      </view>
    </view>
  </view>

  <!-- 数字人面板（全屏） -->
  <view wx:if="{{showAIPanel}}" class="ai-panel-fullscreen">
    <!-- 全屏数字人背景 -->
    <view class="ai-digital-human-bg">
      <digital-human id="digitalHumanExhibit" size="750" bind:message="onDigitalHumanMessage" bind:speakEnd="onSpeakEnd" bind:error="onDigitalHumanError" />
    </view>

    <!-- 顶部关闭按钮 -->
    <view class="ai-fullscreen-header">
      <view class="ai-close-btn" bindtap="toggleAI">✕</view>
    </view>

    <!-- 聊天消息区（底部，不遮挡面部） -->
    <scroll-view class="ai-messages-float" scroll-y="{{true}}" scroll-into-view="{{aiScrollId}}" scroll-with-animation="{{true}}">
      <!-- 欢迎语 -->
      <view class="ai-float-msg ai-float-welcome">
        <view class="ai-float-bubble ai">
          <text>{{welcomeMessage}}</text>
        </view>
      </view>

      <!-- 聊天记录 -->
      <view wx:for="{{aiMessages}}" wx:key="id" id="ai-msg-{{item.id}}">
        <!-- 用户消息 -->
        <view wx:if="{{item.role === 'user'}}" class="ai-float-msg ai-float-user">
          <view class="ai-float-bubble user">
            <text>{{item.text}}</text>
          </view>
        </view>

        <!-- AI消息 -->
        <view wx:if="{{item.role === 'ai'}}" class="ai-float-msg ai-float-ai">
          <view class="ai-float-bubble ai">
            <text wx:if="{{item.loading}}" class="ai-typing-dots"><text></text><text></text><text></text></text>
            <text wx:else>{{item.text}}</text>
          </view>
          <!-- 语音按钮 -->
          <view wx:if="{{item.audioUrl && !item.audioPlaying}}" class="ai-float-audio-btn" bindtap="playAudioUrl" data-audiourl="{{item.audioUrl}}" data-msgid="{{item.id}}">
            <text>▶</text>
          </view>
          <view wx:if="{{item.audioPlaying}}" class="ai-float-audio-btn playing" bindtap="stopAudio">
            <text>⏸</text>
          </view>
        </view>
      </view>
      <view style="height: 40rpx;"></view>
    </scroll-view>

    <!-- 底部区域 -->
    <view class="ai-bottom-float">
      <!-- 预设问题（根据当前页面动态） -->
      <view wx:if="{{!aiChatting && presetQuestions.length > 0}}" class="ai-presets-float">
        <scroll-view scroll-x class="ai-presets-scroll">
          <view class="ai-presets-list">
            <view wx:for="{{presetQuestions}}" wx:key="id" class="ai-preset-chip-float" bindtap="sendPreset" data-id="{{item.id}}" data-question="{{item.question}}">
              <text>{{item.question}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 输入区 -->
      <view class="ai-input-float">
        <input class="ai-input-field" value="{{aiInputValue}}" bindinput="onAiInput" bindconfirm="sendAiMessage" placeholder="输入问题..." disabled="{{aiChatting}}" confirm-type="send" />
        <view class="ai-send-float {{aiChatting || !aiInputValue ? 'disabled' : ''}}" bindtap="sendAiMessage">
          <text>{{aiChatting ? '...' : '发送'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 素材展示面板 -->
  <view wx:if="{{showMaterialsPanel}}" class="panel materials-panel">
    <view class="panel-header materials-header">
      <view class="materials-header-left">
        <text class="materials-header-icon">✦</text>
        <text class="panel-title">阅读成果</text>
      </view>
      <view class="close-btn" bindtap="toggleMaterials">✕</view>
    </view>

    <!-- 分类标签栏 -->
    <view class="works-tabs">
      <view class="works-tab {{worksTab === 'all' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="all">
        <text class="works-tab-icon">◆</text>
        <text>全部</text>
      </view>
      <view class="works-tab {{worksTab === '图片' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="图片">
        <text class="works-tab-icon">🖼</text>
        <text>图片</text>
      </view>
      <view class="works-tab {{worksTab === '视频' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="视频">
        <text class="works-tab-icon">▶</text>
        <text>视频</text>
      </view>
      <view class="works-tab {{worksTab === '漫画' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="漫画">
        <text class="works-tab-icon">📖</text>
        <text>漫画</text>
      </view>
      <view class="works-tab {{worksTab === '文档' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="文档">
        <text class="works-tab-icon">📄</text>
        <text>文档</text>
      </view>
      <view class="works-tab {{worksTab === '其他' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="其他">
        <text class="works-tab-icon">🔗</text>
        <text>其他</text>
      </view>
    </view>

    <!-- 图片网格视图 -->
    <scroll-view class="works-scroll" scroll-y="{{true}}" bindscrolltolower="loadMoreWorks" wx:if="{{worksTab === 'all' || worksTab === '图片'}}">
      <view wx:if="{{worksLoading}}" class="material-loading">
        <text>加载中...</text>
      </view>

      <view wx:if="{{worksList.length === 0 && !worksLoading}}" class="material-empty">
        <text class="material-empty-icon">📚</text>
        <text class="material-empty-text">暂无阅读成果</text>
      </view>

      <view class="works-grid" wx:if="{{worksList.length > 0}}">
        <view wx:for="{{worksList}}" wx:key="fileId" class="works-card" bindtap="previewWork" data-item="{{item}}">
          <!-- 图片卡片 -->
          <view wx:if="{{item.category === '图片'}}" class="works-card-image-wrap">
            <image wx:if="{{item.fileUrl}}" class="works-card-img" src="{{item.fileUrl}}" mode="aspectFill" />
            <view wx:else class="works-card-img-placeholder">
              <view class="works-card-img-glow"></view>
              <text class="works-card-placeholder-icon">🖼</text>
            </view>
          </view>
          <!-- 视频卡片 -->
          <view wx:elif="{{item.category === '视频'}}" class="works-card-video-wrap">
            <image wx:if="{{item.coverUrl}}" class="works-card-video-cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
            <view wx:else class="works-card-video-bg"></view>
            <view class="works-card-video-play">▶</view>
          </view>
          <!-- 文档卡片 -->
          <view wx:else class="works-card-doc-wrap">
            <view class="works-card-doc-lines">
              <view class="works-card-doc-line line-1"></view>
              <view class="works-card-doc-line line-2"></view>
              <view class="works-card-doc-line line-3"></view>
            </view>
            <view class="works-card-doc-badge">{{item.displayName ? item.displayName.substring(0, 3) : 'DOC'}}</view>
          </view>
          <view class="works-card-info">
            <text class="works-card-title">{{item.displayName}}</text>
            <view class="works-card-author-row" wx:if="{{item.displayAuthor}}">
              <view class="works-card-author-dot"></view>
              <text class="works-card-author">{{item.displayAuthor}}</text>
            </view>
            <view class="works-card-rating">
              <view wx:if="{{item.ratingCount > 0}}" class="works-card-rating-stars">
                <view wx:for="{{item.avgStars}}" wx:for-item="starType" wx:for-index="si" wx:key="si" class="works-card-star-wrapper {{starType}}">
                  <text class="works-card-star">★</text>
                </view>
                <text class="works-card-rating-text">{{item.displayScore}}({{item.ratingCount}}人评分)</text>
              </view>
              <text wx:else class="works-card-rating-none">暂无评分</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 视频列表视图 — 网格布局（与"全部"一致） -->
    <scroll-view class="works-scroll" scroll-y="{{true}}" bindscrolltolower="loadMoreWorks" wx:elif="{{worksTab === '视频'}}">
      <view wx:if="{{worksLoading}}" class="material-loading">
        <text>加载中...</text>
      </view>
      <view wx:if="{{worksList.length === 0 && !worksLoading}}" class="material-empty">
        <text class="material-empty-icon">📺</text>
        <text class="material-empty-text">暂无视频成果</text>
      </view>
      <view class="works-grid" wx:if="{{worksList.length > 0}}">
        <view wx:for="{{worksList}}" wx:key="fileId" class="works-card" bindtap="previewWork" data-item="{{item}}">
          <view class="works-card-video-wrap">
            <image wx:if="{{item.coverUrl}}" class="works-card-video-cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
            <view wx:else class="works-card-video-bg"></view>
            <view class="works-card-video-play">▶</view>
          </view>
          <view class="works-card-info">
            <text class="works-card-title">{{item.displayName}}</text>
            <view class="works-card-author-row" wx:if="{{item.displayAuthor}}">
              <view class="works-card-author-dot"></view>
              <text class="works-card-author">{{item.displayAuthor}}</text>
            </view>
            <view class="works-card-rating">
              <view wx:if="{{item.ratingCount > 0}}" class="works-card-rating-stars">
                <view wx:for="{{item.avgStars}}" wx:for-item="starType" wx:for-index="si" wx:key="si" class="works-card-star-wrapper {{starType}}">
                  <text class="works-card-star">★</text>
                </view>
                <text class="works-card-rating-text">{{item.displayScore}}({{item.ratingCount}}人评分)</text>
              </view>
              <text wx:else class="works-card-rating-none">暂无评分</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 文档列表视图 -->
    <scroll-view class="works-scroll" scroll-y="{{true}}" bindscrolltolower="loadMoreWorks" wx:elif="{{worksTab === '文档'}}">
      <view wx:if="{{worksLoading}}" class="material-loading">
        <text>加载中...</text>
      </view>
      <view wx:if="{{worksList.length === 0 && !worksLoading}}" class="material-empty">
        <text class="material-empty-icon">📋</text>
        <text class="material-empty-text">暂无文档成果</text>
      </view>
      <view class="works-list" wx:if="{{worksList.length > 0}}">
        <view wx:for="{{worksList}}" wx:key="fileId" class="works-list-card" bindtap="previewWork" data-item="{{item}}">
          <view class="works-list-doc-thumb">
            <view class="works-list-doc-icon-inner">📄</view>
          </view>
          <view class="works-list-info">
            <text class="works-list-title">{{item.displayName}}</text>
            <view class="works-list-author-row" wx:if="{{item.displayAuthor}}">
              <view class="works-list-author-dot"></view>
              <text class="works-card-author">{{item.displayAuthor}}</text>
            </view>
            <view class="works-card-rating">
              <view wx:if="{{item.ratingCount > 0}}" class="works-card-rating-stars">
                <view wx:for="{{item.avgStars}}" wx:for-item="starType" wx:for-index="si" wx:key="si" class="works-card-star-wrapper {{starType}}">
                  <text class="works-card-star">★</text>
                </view>
                <text class="works-card-rating-text">{{item.displayScore}}({{item.ratingCount}}人评分)</text>
              </view>
              <text wx:else class="works-card-rating-none">暂无评分</text>
            </view>
            <view class="works-list-rating-btn" catchtap="openRatingModal" data-item="{{item}}">
              <text wx:if="{{item.hasRated}}">已评</text>
              <text wx:else>评分</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 其他列表视图 -->
    <scroll-view class="works-scroll" scroll-y="{{true}}" bindscrolltolower="loadMoreWorks" wx:elif="{{worksTab === '其他'}}">
      <view wx:if="{{worksLoading}}" class="material-loading">
        <text>加载中...</text>
      </view>
      <view wx:if="{{worksList.length === 0 && !worksLoading}}" class="material-empty">
        <text class="material-empty-icon">🔗</text>
        <text class="material-empty-text">暂无其他资源</text>
      </view>
      <view class="works-list" wx:if="{{worksList.length > 0}}">
        <view wx:for="{{worksList}}" wx:key="fileId" class="works-list-card works-link-card" bindtap="openLink" data-item="{{item}}">
          <view class="works-list-link-thumb">
            <text>🔗</text>
          </view>
          <view class="works-list-info works-other-info">
            <text class="works-list-title">{{item.displayName}}</text>
            <view class="works-list-author-row" wx:if="{{item.displayAuthor}}">
              <view class="works-list-author-dot"></view>
              <text class="works-card-author">{{item.displayAuthor}}</text>
            </view>
            <view class="works-other-link-row">
              <text class="works-link-url">{{item.fileId}}</text>
              <view class="works-list-rating-btn" catchtap="openRatingModal" data-item="{{item}}">
                <text wx:if="{{item.hasRated}}">已评</text>
                <text wx:else>评分</text>
              </view>
            </view>
            <view class="works-card-rating">
              <view wx:if="{{item.ratingCount > 0}}" class="works-card-rating-stars">
                <view wx:for="{{item.avgStars}}" wx:for-item="starType" wx:for-index="si" wx:key="si" class="works-card-star-wrapper {{starType}}">
                  <text class="works-card-star">★</text>
                </view>
                <text class="works-card-rating-text">{{item.displayScore}}({{item.ratingCount}}人评分)</text>
              </view>
              <text wx:else class="works-card-rating-none">暂无评分</text>
            </view>
          </view>
          <view class="works-link-arrow">›</view>
        </view>
      </view>
    </scroll-view>

    <!-- 漫画列表视图 -->
    <scroll-view class="works-scroll" scroll-y="{{true}}" bindscrolltolower="loadMoreWorks" wx:elif="{{worksTab === '漫画'}}">
      <view wx:if="{{worksLoading}}" class="material-loading">
        <text>加载中...</text>
      </view>
      <view wx:if="{{mangaGroups.length === 0 && !worksLoading}}" class="material-empty">
        <text class="material-empty-icon">📚</text>
        <text class="material-empty-text">暂无漫画成果</text>
      </view>
      <view class="works-grid" wx:if="{{mangaGroups.length > 0}}">
        <view wx:for="{{mangaGroups}}" wx:key="groupId" class="works-card works-manga-card" bindtap="openMangaViewer" data-group="{{item}}">
          <view class="works-card-manga-cover">
            <image wx:if="{{item.pages[0].fileUrl}}" class="works-card-manga-img" src="{{item.pages[0].fileUrl}}" mode="aspectFill" />
            <view wx:else class="works-card-manga-placeholder">
              <view class="works-card-img-glow"></view>
              <text class="works-card-placeholder-icon">📖</text>
            </view>
            <view class="works-manga-page-count">{{item.pages.length}}P</view>
          </view>
          <view class="works-card-info">
            <text class="works-manga-title">{{item.title}}</text>
            <view class="works-card-author-row" wx:if="{{item.author}}">
              <view class="works-card-author-dot"></view>
              <text class="works-manga-author">{{item.author}}</text>
            </view>
            <view class="works-card-rating">
              <view wx:if="{{item.ratingCount > 0}}" class="works-card-rating-stars">
                <view wx:for="{{item.avgStars}}" wx:for-item="starType" wx:for-index="si" wx:key="si" class="works-card-star-wrapper {{starType}}">
                  <text class="works-card-star">★</text>
                </view>
                <text class="works-card-rating-text">{{item.displayScore}}({{item.ratingCount}}人评分)</text>
              </view>
              <text wx:else class="works-card-rating-none">暂无评分</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 评分弹窗 -->
  <view class="rating-modal" wx:if="{{showRatingModal}}" catchtap="closeRatingModal">
    <view class="rating-modal-content" catchtap="stopTap">
      <text class="rating-modal-title">{{ratingItem.displayName}}</text>
      <text wx:if="{{ratingItem.displayAuthor}}" class="rating-modal-author">{{ratingItem.displayAuthor}}</text>

      <!-- 五颗大星星 -->
      <view class="rating-modal-stars">
        <view class="rating-modal-star-btn {{modalUserStars[0]}}" data-score="1" catchtap="onModalStarTap">
          <text class="rating-modal-star">★</text>
        </view>
        <view class="rating-modal-star-btn {{modalUserStars[1]}}" data-score="2" catchtap="onModalStarTap">
          <text class="rating-modal-star">★</text>
        </view>
        <view class="rating-modal-star-btn {{modalUserStars[2]}}" data-score="3" catchtap="onModalStarTap">
          <text class="rating-modal-star">★</text>
        </view>
        <view class="rating-modal-star-btn {{modalUserStars[3]}}" data-score="4" catchtap="onModalStarTap">
          <text class="rating-modal-star">★</text>
        </view>
        <view class="rating-modal-star-btn {{modalUserStars[4]}}" data-score="5" catchtap="onModalStarTap">
          <text class="rating-modal-star">★</text>
        </view>
      </view>

      <!-- 提示文字 -->
      <text wx:if="{{modalHasRated}}" class="rating-modal-hint">已评价，点击星星可重新评分</text>
      <text wx:else class="rating-modal-hint">请进行评价</text>

      <view class="rating-modal-close" bindtap="closeRatingModal">关闭</view>
    </view>
  </view>

  <!-- 致敬墙全部评论面板（底部弹出） -->
  <view class="tribute-panel-overlay {{showTributePanel ? 'visible' : ''}}" catchtap="closeTributePanel">
    <view class="tribute-panel" catchtap="stopTap">
      <!-- 顶部拖拽条 -->
      <view class="tribute-panel-handle">
        <view class="tribute-panel-indicator"></view>
        <text class="tribute-panel-title">全部致敬</text>
        <view class="tribute-panel-close" bindtap="closeTributePanel">✕</view>
      </view>

      <!-- 致敬列表 -->
      <scroll-view class="tribute-panel-list" scroll-y="{{true}}" enhanced show-scrollbar="{{false}}">
        <view wx:if="{{userTributes.length > 0}}">
          <view wx:for="{{userTributes}}" wx:key="_id" class="tribute-panel-card">
            <view class="tribute-panel-card-top">
              <view class="tribute-panel-avatar">
                <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="tribute-panel-avatar-img" />
                <text wx:else class="tribute-panel-avatar-text">👤</text>
              </view>
              <view class="tribute-panel-meta">
                <text class="tribute-panel-nickname">{{item.nickname}}</text>
                <text class="tribute-panel-time">{{item.createdAt}}</text>
              </view>
            </view>
            <text class="tribute-panel-message">{{item.message}}</text>
          </view>

          <view class="tribute-panel-end">
            <text>—— 致敬不息，追光不止 ——</text>
          </view>
        </view>

        <view wx:else class="tribute-panel-empty">
          <text class="tribute-panel-empty-icon">🕊</text>
          <text>暂无致敬留言</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 知识问答面板 -->
  <view class="panel quiz-panel" wx:if="{{showQuizPanel}}">
    <!-- 背景装饰 -->
    <view class="quiz-bg"></view>
    <!-- 背景粒子 -->
    <view class="quiz-particles">
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
      <view class="quiz-particle"></view>
    </view>
    <view class="panel-header">
      <text class="panel-title">知识问答</text>
      <view class="close-btn" bindtap="toggleQuiz">✕</view>
    </view>

    <!-- 答题结果 -->
    <view wx:if="{{quizCompleted}}" class="quiz-result">
      <view class="result-card {{quizScore === 5 ? 'perfect' : (quizScore >= 3 ? 'good' : 'bad')}}">
        <view class="result-icon">{{quizScore === 5 ? '👑' : (quizScore >= 3 ? '👍' : '💪')}}</view>
        <view class="result-score-text">
          <text class="result-label">你答对了</text>
          <text class="result-num">{{quizScore}}</text>
          <text class="result-unit">题</text>
        </view>
        <view class="result-msg">
          <text wx:if="{{quizScore === 5}}">全部正确！获得「知识王者」徽章！</text>
          <text wx:elif="{{quizScore >= 3}}">表现不错，再接再厉！</text>
          <text wx:else>继续学习，下次一定能更好！</text>
        </view>
      </view>
      <view class="result-actions">
        <button wx:if="{{quizWrongAnswers.length > 0}}" class="btn-retry btn-wrong-review" bindtap="retryWrongAnswers">
          重答错题 ({{quizWrongAnswers.length}})
        </button>
        <button class="btn-retry" bindtap="initQuiz">全部重答</button>
      </view>
    </view>

    <!-- 错题回顾区 -->
    <view wx:if="{{showWrongReview && quizWrongAnswers.length > 0}}" class="wrong-review-section">
      <view class="wrong-review-header">
        <text class="wrh-title">错题回顾</text>
        <view class="wrh-close" bindtap="toggleWrongReview">✕</view>
      </view>
      <scroll-view class="wrong-review-scroll" scroll-y="true">
        <view wx:for="{{quizWrongAnswers}}" wx:key="index" class="wrong-review-item">
          <view class="wr-question">
            <text class="wr-q-num">Q{{index + 1}}</text>
            <text class="wr-q-text">{{item.question}}</text>
          </view>
          <!-- 判断题 -->
          <view wx:if="{{item.type === 'judge'}}" class="wr-options">
            <view class="wr-option {{item.selected === 0 ? 'wrong' : ''}} {{item.answer === 0 ? 'correct-opt' : ''}}">
              <text>✗</text>
            </view>
            <view class="wr-option {{item.selected === 1 ? 'wrong' : ''}} {{item.answer === 1 ? 'correct-opt' : ''}}">
              <text>✓</text>
            </view>
          </view>
          <!-- 选择题 -->
          <view wx:if="{{item.type === 'choice'}}" class="wr-options">
            <view wx:for="{{item.options}}" wx:for-item="opt" wx:for-index="idx" wx:key="idx"
                  class="wr-option {{item.selected === idx ? 'wrong' : ''}} {{item.answer === idx ? 'correct-opt' : ''}}">
              <text class="wr-opt-label">{{['A', 'B', 'C', 'D'][idx]}}</text>
              <text class="wr-opt-text">{{opt}}</text>
            </view>
          </view>
          <view class="wr-answer-hint">
            <text>正确答案：</text>
            <text class="wr-answer-val">{{item.type === 'judge' ? (item.answer === 1 ? '正确 ✓' : '错误 ✗') : (['A', 'B', 'C', 'D'][item.answer])}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 题目列表 -->
    <scroll-view class="quiz-scroll" scroll-y="true" scroll-into-view="{{quizScrollId}}" scroll-with-animation="true">
      <view wx:for="{{quizQuestions}}" wx:key="index" id="quiz-q-{{item.index}}"
            class="quiz-question-wrap {{index === quizCurrentIndex ? 'current' : ''}}">
        <view class="quiz-question {{item.type === 'choice' ? 'choice' : 'judge'}}">
          <view class="quiz-q-header">
            <text class="quiz-q-num">Q{{item.index + 1}}</text>
            <text class="quiz-q-type {{item.type === 'choice' ? 'tag-choice' : 'tag-judge'}}">{{item.type === 'choice' ? '四选一' : '判断题'}}</text>
          </view>
          <view class="quiz-q-text">{{item.question}}</view>

          <!-- 选择题选项 -->
          <view class="quiz-options" wx:if="{{item.type === 'choice'}}">
            <view class="quiz-option {{item.selected === idx ? (item.correct ? 'correct' : 'wrong') : ''}} {{item.selected !== null ? 'disabled' : ''}}"
                  wx:for="{{item.options}}" wx:for-item="opt" wx:key="idx" wx:for-index="idx"
                  bindtap="selectQuizAnswer" data-q-index="{{item.index}}" data-option-index="{{idx}}">
              <text class="opt-label">{{['A', 'B', 'C', 'D'][idx]}}</text>
              <text class="opt-text">{{opt}}</text>
              <text wx:if="{{item.selected === idx && item.correct}}" class="opt-icon correct-icon">✓</text>
              <text wx:if="{{item.selected === idx && !item.correct}}" class="opt-icon wrong-icon">✗</text>
            </view>
          </view>

          <!-- 判断题选项 -->
          <view class="quiz-options judge-options" wx:if="{{item.type === 'judge'}}">
            <view class="quiz-option {{item.selected === 0 ? (item.correct ? 'correct' : 'wrong') : ''}} {{item.selected !== null ? 'disabled' : ''}}"
                  bindtap="selectQuizAnswer" data-q-index="{{item.index}}" data-option-index="0">
              <text class="opt-label">✗</text>
              <text class="opt-text">错误</text>
            </view>
            <view class="quiz-option {{item.selected === 1 ? (item.correct ? 'correct' : 'wrong') : ''}} {{item.selected !== null ? 'disabled' : ''}}"
                  bindtap="selectQuizAnswer" data-q-index="{{item.index}}" data-option-index="1">
              <text class="opt-label">✓</text>
              <text class="opt-text">正确</text>
            </view>
          </view>
        </view>
      </view>
      <view style="height: 100rpx;"></view>
    </scroll-view>
  </view>

</view>
