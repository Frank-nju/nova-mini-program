  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.4));
}

.tribute-deco-line:last-child {
  background: linear-gradient(90deg, rgba(201, 169, 110, 0.4), transparent);
}

.tribute-deco-diamond {
  width: 16rpx;
  height: 16rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.5);
  transform: rotate(45deg);
  margin: 0 16rpx;
  background: rgba(201, 169, 110, 0.08);
}

.tribute-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.tribute-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: rgba(255, 215, 0, 0.85);
  letter-spacing: 10rpx;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.15);
}

.tribute-line {
  width: 140rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.5), transparent);
  margin: 18rpx auto;
}

.tribute-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(201, 169, 110, 0.4);
  letter-spacing: 6rpx;
}

/* 致敬卡片 */
.tribute-card {
