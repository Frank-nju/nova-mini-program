
/* ========== 全屏数字人面板 ========== */
.ai-panel-fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  overflow: hidden;
}

/* 全屏数字人背景 */
.ai-digital-human-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.ai-digital-human-bg digital-human {
  width: 100%;
  height: 100%;
}

/* 顶部关闭按钮 */
.ai-fullscreen-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding: 40rpx 24rpx 0;
  display: flex;
  justify-content: flex-end;
  z-index: 100;
  background: linear-gradient(180deg, rgba(10, 10, 15, 0.8) 0%, transparent 100%);
}

.ai-close-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  backdrop-filter: blur(10rpx);
  font-size: 32rpx;
  color: #fff;
}

/* 聊天消息区（上半部分，避开面部） */
.ai-messages-float {
  position: absolute;
  top: 120rpx;
  left: 0;
  right: 0;
  height: 40vh;
  z-index: 10;
  padding: 0 24rpx;
}

/* 消息样式 */
.ai-float-msg {
  display: flex;
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.ai-float-user {
  justify-content: flex-end;
}

.ai-float-ai {
  justify-content: flex-start;
  flex-direction: column;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 半透明气泡 */
.ai-float-bubble {
  max-width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(20rpx);
  font-size: 26rpx;
  line-height: 1.6;
}

.ai-float-bubble.user {
  background: rgba(30, 58, 95, 0.85);
  border: 1rpx solid rgba(100, 180, 255, 0.2);
  color: rgba(255, 255, 255, 0.95);
}

.ai-float-bubble.ai {
  background: rgba(30, 30, 45, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.95);
}

/* 音频按钮 */
.ai-float-audio-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-top: 12rpx;
  background: rgba(100, 180, 255, 0.2);
  border-radius: 26rpx;
  border: 1rpx solid rgba(100, 180, 255, 0.3);
  font-size: 22rpx;
  color: #64b4ff;
}

.ai-float-audio-btn.playing {
  background: rgba(100, 180, 255, 0.4);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* 底部区域 */
.ai-bottom-float {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(10, 10, 15, 0.95) 0%, rgba(10, 10, 15, 0.7) 60%, transparent 100%);
  z-index: 100;
}

/* 预设问题 */
.ai-presets-float {
  margin-bottom: 16rpx;
}

.ai-presets-scroll {
  white-space: nowrap;
}

.ai-presets-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx;
}

.ai-preset-chip-float {
  display: inline-flex;
  padding: 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  backdrop-filter: blur(10rpx);
}

.ai-preset-chip-float text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

/* 输入区 */
.ai-input-float {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(30, 30, 45, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 44rpx;
  backdrop-filter: blur(20rpx);
}

.ai-input-field {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #fff;
  background: transparent;
}

.ai-input-field::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.ai-send-float {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #1e3a5f, #0f2847);
  border-radius: 28rpx;
}

.ai-send-float.disabled {
  opacity: 0.5;
}

.ai-send-float text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}
