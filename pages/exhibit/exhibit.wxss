@keyframes quiz-particle-float {
  0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.3; }
  25% { transform: translate(30rpx, -40rpx) scale(1.3); opacity: 0.7; }
  50% { transform: translate(-20rpx, -70rpx) scale(0.8); opacity: 0.4; }
  75% { transform: translate(35rpx, -30rpx) scale(1.1); opacity: 0.6; }
}

/* 面板滑动动画 */
@keyframes slide-up-panel {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.quiz-scroll {
  height: 60vh;
  position: relative;
  z-index: 1;
  scroll-behavior: smooth;
}

/* 滚动条美化 */
.quiz-scroll::-webkit-scrollbar {
  width: 6rpx;
}
.quiz-scroll::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.02);
  border-radius: 3rpx;
}
.quiz-scroll::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(100, 200, 255, 0.4), rgba(201, 169, 110, 0.3));
  border-radius: 3rpx;
}

/* 答题面板标题 */
.quiz-panel .panel-header {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(100, 200, 255, 0.12);
  position: relative;
  z-index: 2;
  animation: header-fade-in 0.6s ease-out;
}

@keyframes header-fade-in {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.quiz-panel .panel-header::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, #64c8ff, transparent);
}

.quiz-panel .panel-title {
  font-size: 42rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #f0ede6 0%, #64c8ff 50%, #c9a96e 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 2rpx;
}

.quiz-panel .close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(100, 200, 255, 0.08);
  border: 1rpx solid rgba(100, 200, 255, 0.2);
}

.quiz-panel .close-btn:active {
  transform: rotate(90deg) scale(0.8);
  background: rgba(100, 200, 255, 0.15);
}

/* ===== 进度指示条 ===== */
.quiz-progress-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 0 24rpx;
}

.quiz-progress-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(100, 200, 255, 0.2);
  border: 1rpx solid rgba(100, 200, 255, 0.3);
  transition: all 0.3s ease;
}

.quiz-progress-dot.active {
  background: #64c8ff;
  box-shadow: 0 0 12rpx rgba(100, 200, 255, 0.5);
  transform: scale(1.3);
}

.quiz-progress-dot.done {
  background: #20b2aa;
  box-shadow: 0 0 8rpx rgba(32, 178, 170, 0.4);
}

.quiz-progress-line {
  width: 32rpx;
  height: 2rpx;
  background: rgba(100, 200, 255, 0.15);
}

/* ===== 答题结果卡片 ===== */
.quiz-result {
  text-align: center;
  padding: 40rpx 0;
  margin-bottom: 24rpx;
  animation: result-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  z-index: 1;
}

@keyframes result-pop {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.result-card {
  padding: 56rpx 32rpx 40rpx;
  border-radius: 28rpx;
  margin: 0 16rpx 28rpx;
  position: relative;
  overflow: hidden;
}

/* 完美 - 金色皇冠 */
.result-card.perfect {
  background:
    radial-gradient(ellipse at 30% 20%, rgba(255, 215, 0, 0.12) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(255, 180, 0, 0.06) 0%, transparent 50%),
    linear-gradient(135deg, rgba(30, 25, 10, 0.9) 0%, rgba(20, 18, 8, 0.95) 100%);
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  box-shadow:
    0 0 60rpx rgba(255, 215, 0, 0.15),
    0 8rpx 40rpx rgba(0, 0, 0, 0.5),
    inset 0 0 60rpx rgba(255, 215, 0, 0.03);
}

/* 良好 - 青绿 */
.result-card.good {
  background:
    radial-gradient(ellipse at 30% 20%, rgba(32, 178, 170, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(0, 128, 128, 0.05) 0%, transparent 50%),
    linear-gradient(135deg, rgba(10, 25, 25, 0.9) 0%, rgba(8, 18, 18, 0.95) 100%);
  border: 2rpx solid rgba(32, 178, 170, 0.35);
  box-shadow:
    0 0 40rpx rgba(32, 178, 170, 0.12),
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    inset 0 0 40rpx rgba(32, 178, 170, 0.02);
}

/* 需努力 - 暖红 */
.result-card.bad {
  background:
    radial-gradient(ellipse at 30% 20%, rgba(255, 100, 100, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(200, 50, 50, 0.04) 0%, transparent 50%),
    linear-gradient(135deg, rgba(25, 10, 10, 0.9) 0%, rgba(18, 8, 8, 0.95) 100%);
  border: 2rpx solid rgba(255, 80, 80, 0.25);
  box-shadow:
    0 0 30rpx rgba(255, 80, 80, 0.08),
    0 8rpx 24rpx rgba(0, 0, 0, 0.3),
    inset 0 0 30rpx rgba(255, 80, 80, 0.02);
}

/* 卡片扫光 */
.result-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -100%;
  width: 80%;
  height: 200%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.04), transparent);
  animation: result-card-shine 5s ease-in-out infinite;
  z-index: 0;
}

@keyframes result-card-shine {
  0% { left: -100%; }
  100% { left: 200%; }
}

/* 四角装饰 */
.result-card::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.1);
  border-right: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 0 8rpx 0 0;
  z-index: 0;
}

.result-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
  animation: icon-bounce 1.2s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.3));
}

@keyframes icon-bounce {
  0%, 100% { transform: scale(1) translateY(0); }
  50% { transform: scale(1.12) translateY(-10rpx); }
}

/* 分数圆环装饰 */
.result-score-text {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.result-label {
  font-size: 28rpx;
  color: rgba(240, 237, 230, 0.6);
}

.result-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #64c8ff;
  line-height: 1;
  margin: 0 4rpx;
}

.result-card.perfect .result-num {
  color: #ffd700;
  text-shadow: 0 0 24rpx rgba(255, 215, 0, 0.6), 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.result-card.good .result-num {
  color: #20b2aa;
  text-shadow: 0 0 20rpx rgba(32, 178, 170, 0.5);
}

.result-card.bad .result-num {
  color: #ff6b6b;
  text-shadow: 0 0 16rpx rgba(255, 80, 80, 0.3);
}

.result-unit {
  font-size: 28rpx;
  color: rgba(240, 237, 230, 0.6);
  margin-left: 4rpx;
}

.result-msg {
  font-size: 26rpx;
  color: #c9a96e;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.btn-retry {
  display: inline-block;
  padding: 24rpx 72rpx;
  background: linear-gradient(135deg, #64c8ff 0%, #4a88c8 100%);
  border: none;
  border-radius: 24rpx;
  color: #0a0a0f;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 0 28rpx rgba(100, 200, 255, 0.3), 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
  position: relative;
  z-index: 1;
  animation: btn-retry-pulse 2s ease-in-out infinite;
}

@keyframes btn-retry-pulse {
  0%, 100% { box-shadow: 0 0 28rpx rgba(100, 200, 255, 0.3), 0 6rpx 20rpx rgba(0, 0, 0, 0.3); }
  50% { box-shadow: 0 0 40rpx rgba(100, 200, 255, 0.5), 0 6rpx 24rpx rgba(0, 0, 0, 0.4); }
}

.btn-retry:active {
  transform: scale(0.95);
  box-shadow: 0 0 40rpx rgba(100, 200, 255, 0.5);
}

/* ===== 题目包装 ===== */
.quiz-question-wrap {
  margin-bottom: 24rpx;
  transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  opacity: 0.3;
  transform: scale(0.94) translateY(12rpx);
  filter: blur(1rpx);
}

.quiz-question-wrap.current {
  opacity: 1;
  transform: scale(1) translateY(0);
  filter: none;
}

/* ===== 题目卡片 ===== */
.quiz-question {
  background: linear-gradient(145deg, rgba(22, 22, 46, 0.95) 0%, rgba(16, 16, 36, 0.98) 100%);
  border: 1rpx solid rgba(100, 200, 255, 0.15);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow:
    0 6rpx 30rpx rgba(0, 0, 0, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
}

/* 顶部彩色装饰条 */
.quiz-question::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #64c8ff, #c9a96e, #ff69b4);
  border-radius: 24rpx 24rpx 0 0;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.quiz-question-wrap.current .quiz-question::before {
  opacity: 1;
}

/* 右上角装饰光斑 */
.quiz-question::after {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle at center, rgba(100, 200, 255, 0.08), transparent 70%);
  border-radius: 50%;
}

.quiz-question-wrap.current .quiz-question {
  border-color: rgba(100, 200, 255, 0.4);
  box-shadow:
    0 0 50rpx rgba(100, 200, 255, 0.15),
    0 8rpx 40rpx rgba(0, 0, 0, 0.6),
    inset 0 0 60rpx rgba(100, 200, 255, 0.03);
}

/* 题号 + 类型标签 */
.quiz-q-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

/* 题号圆形徽章 */
.quiz-q-num {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(100, 200, 255, 0.15), rgba(100, 200, 255, 0.05));
  border: 2rpx solid rgba(100, 200, 255, 0.3);
  font-size: 24rpx;
  font-weight: 800;
  color: #64c8ff;
  box-shadow: 0 0 16rpx rgba(100, 200, 255, 0.15);
  flex-shrink: 0;
}

.quiz-q-type {
  font-size: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 14rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tag-choice {
  background: linear-gradient(135deg, rgba(100, 200, 255, 0.15), rgba(100, 200, 255, 0.08));
  color: #64c8ff;
  border: 1rpx solid rgba(100, 200, 255, 0.2);
}

.tag-judge {
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.15), rgba(201, 169, 110, 0.08));
  color: #c9a96e;
  border: 1rpx solid rgba(201, 169, 110, 0.2);
}

/* 题目文字 */
.quiz-q-text {
  font-size: 32rpx;
  color: #f0ede6;
  line-height: 1.9;
  margin-bottom: 32rpx;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* ===== 选项 ===== */
.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quiz-options.judge-options {
  flex-direction: row;
  gap: 24rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  background: linear-gradient(135deg, rgba(36, 36, 62, 0.8) 0%, rgba(28, 28, 48, 0.9) 100%);
  border: 1rpx solid rgba(100, 200, 255, 0.1);
  border-radius: 18rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
}

/* 左侧高亮条 */
.quiz-option::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15%;
  bottom: 15%;
  width: 5rpx;
  background: rgba(100, 200, 255, 0.6);
  border-radius: 0 3rpx 3rpx 0;
  opacity: 0;
  transition: all 0.4s ease;
}

/* 选项扫光效果 */
.quiz-option::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
  transition: none;
  pointer-events: none;
}

.quiz-option:not(.disabled):active::after {
  animation: option-shine 0.6s ease-out;
}

@keyframes option-shine {
  0% { left: -100%; }
  100% { left: 200%; }
}

/* 选项字母 */
.quiz-option .opt-label {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: rgba(100, 200, 255, 0.12);
  border: 1rpx solid rgba(100, 200, 255, 0.25);
  font-size: 24rpx;
  font-weight: 800;
  color: #64c8ff;
  flex-shrink: 0;
  transition: all 0.4s ease;
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.1);
}

.quiz-option .opt-text {
  font-size: 30rpx;
  color: #d8d8e8;
  flex: 1;
  line-height: 1.6;
}

.quiz-option .opt-icon {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 未选择 - 悬停/按压 */
.quiz-option:not(.disabled):active {
  background: linear-gradient(135deg, rgba(100, 200, 255, 0.15) 0%, rgba(80, 160, 200, 0.1) 100%);
  border-color: rgba(100, 200, 255, 0.35);
  transform: scale(0.97);
  box-shadow: 0 0 20rpx rgba(100, 200, 255, 0.15);
}

.quiz-option:not(.disabled):active::before {
  opacity: 1;
}

.quiz-option:not(.disabled):active .opt-label {
  background: rgba(100, 200, 255, 0.25);
  border-color: rgba(100, 200, 255, 0.6);
  box-shadow: 0 0 12rpx rgba(100, 200, 255, 0.3);
}

/* 正确答案 — 强动画 */
.quiz-option.correct {
  background: linear-gradient(135deg, rgba(32, 178, 170, 0.32) 0%, rgba(16, 100, 96, 0.25) 100%);
  border-color: rgba(32, 178, 170, 0.85);
  box-shadow: 0 0 50rpx rgba(32, 178, 170, 0.4), 0 4rpx 24rpx rgba(0, 0, 0, 0.5);
  animation: correct-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes correct-pop {
  0% { transform: scale(1); }
  30% { transform: scale(1.06); }
  60% { transform: scale(0.98); }
  100% { transform: scale(1); }
}

.quiz-option.correct::before {
  background: linear-gradient(180deg, #20b2aa, #008080);
  opacity: 1;
  box-shadow: 0 0 16rpx rgba(32, 178, 170, 0.8);
  animation: correct-glow-bar 0.8s ease-out forwards;
}

@keyframes correct-glow-bar {
  0% { box-shadow: 0 0 4rpx rgba(32, 178, 170, 0.3); }
  100% { box-shadow: 0 0 24rpx rgba(32, 178, 170, 1), 0 0 48rpx rgba(32, 178, 170, 0.5); }
}

.quiz-option.correct .opt-label {
  background: rgba(32, 178, 170, 0.4);
  border-color: rgba(32, 178, 170, 0.9);
  color: #20b2aa;
  box-shadow: 0 0 20rpx rgba(32, 178, 170, 0.5);
}

/* 错误答案 — 强动画 */
.quiz-option.wrong {
  background: linear-gradient(135deg, rgba(255, 70, 70, 0.28) 0%, rgba(180, 40, 40, 0.2) 100%);
  border-color: rgba(255, 70, 70, 0.75);
  box-shadow: 0 0 44rpx rgba(255, 70, 70, 0.35), 0 4rpx 24rpx rgba(0, 0, 0, 0.5);
  animation: wrong-shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) forwards;
}

@keyframes wrong-shake {
  0% { transform: translateX(0); }
  10% { transform: translateX(-14rpx); }
  20% { transform: translateX(12rpx); }
  30% { transform: translateX(-10rpx); }
  40% { transform: translateX(8rpx); }
  50% { transform: translateX(-6rpx); }
  60% { transform: translateX(4rpx); }
  70% { transform: translateX(-2rpx); }
  100% { transform: translateX(0); }
}

.quiz-option.wrong::before {
  background: linear-gradient(180deg, #ff4646, #c03030);
  opacity: 1;
  box-shadow: 0 0 16rpx rgba(255, 70, 70, 0.8);
  animation: wrong-glow-bar 0.8s ease-out forwards;
}

@keyframes wrong-glow-bar {
  0% { box-shadow: 0 0 4rpx rgba(255, 70, 70, 0.3); }
  100% { box-shadow: 0 0 24rpx rgba(255, 70, 70, 1), 0 0 48rpx rgba(255, 70, 70, 0.5); }
}

.quiz-option.wrong .opt-label {
  background: rgba(255, 70, 70, 0.35);
  border-color: rgba(255, 70, 70, 0.85);
  color: #ff4646;
  box-shadow: 0 0 16rpx rgba(255, 70, 70, 0.4);
}

.quiz-option.disabled {
  pointer-events: none;
}

.opt-icon.correct-icon {
  color: #20b2aa;
  text-shadow: 0 0 12rpx rgba(32, 178, 170, 0.6);
}

.opt-icon.wrong-icon {
  color: #ff4646;
  text-shadow: 0 0 12rpx rgba(255, 70, 70, 0.5);
}

/* ========== 制作团队 ========== */
.section-credits {
  background: linear-gradient(180deg, #0a0a0f 0%, #0f0f1a 50%, #0a0a0f 100%);
}

.credits-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  animation: credits-fade-in 1.5s ease-out;
}

@keyframes credits-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 装饰线 */
.credits-decoration {
  width: 200rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.6), transparent);
}

.credits-line-top {
  margin-bottom: 48rpx;
  animation: line-expand-left 1s ease-out 0.3s both;
}

.credits-line-bottom {
  margin-top: 48rpx;
  animation: line-expand-right 1s ease-out 0.5s both;
}

@keyframes line-expand-left {
  from { width: 0; opacity: 0; }
  to { width: 200rpx; opacity: 1; }
}

@keyframes line-expand-right {
  from { width: 0; opacity: 0; }
  to { width: 200rpx; opacity: 1; }
}

/* 标题区域 */
.credits-title-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  position: relative;
  z-index: 2;
}

.credits-label {
  font-size: 32rpx;
  color: rgba(201, 169, 110, 0.7);
  letter-spacing: 8rpx;
  font-weight: 500;
  animation: credits-label-appear 0.8s ease-out 0.5s both;
}

@keyframes credits-label-appear {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.credits-title-line {
  width: 120rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #ffd700, transparent);
  animation: credits-line-glow 2s ease-in-out infinite;
}

@keyframes credits-line-glow {
  0%, 100% { opacity: 0.5; box-shadow: 0 0 8rpx rgba(255, 215, 0, 0.3); }
  50% { opacity: 1; box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6); }
}

.credits-team-name {
  font-size: 64rpx;
  font-weight: 800;
  color: #f0e6d2;
  letter-spacing: 12rpx;
  text-shadow:
    0 0 30rpx rgba(255, 215, 0, 0.3),
    0 0 60rpx rgba(201, 169, 110, 0.2),
    0 4px 20px rgba(0, 0, 0, 0.5);
  animation: team-name-reveal 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s both;
  position: relative;
}

/* 名字扫光效果 */
.credits-team-name::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -100%;
  width: 60%;
  height: 140%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
  animation: team-name-shine 3s ease-in-out infinite 2s;
}

@keyframes team-name-shine {
  0% { left: -100%; }
  100% { left: 200%; }
}

@keyframes team-name-reveal {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(30rpx);
    letter-spacing: 30rpx;
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
    letter-spacing: 12rpx;
  }
}

/* 粒子装饰 */
.credits-particles {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.credits-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 215, 0, 0.6);
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.4);
}

.credits-particle.p1 {
  left: 20%; top: 30%;
  animation: credits-particle-float 4s ease-in-out infinite 0s;
}
.credits-particle.p2 {
  left: 75%; top: 25%;
  animation: credits-particle-float 4.5s ease-in-out infinite 0.5s;
  background: rgba(100, 200, 255, 0.5);
  box-shadow: 0 0 12rpx rgba(100, 200, 255, 0.4);
}
.credits-particle.p3 {
  left: 35%; top: 65%;
  animation: credits-particle-float 5s ease-in-out infinite 1s;
}
.credits-particle.p4 {
  left: 65%; top: 70%;
  animation: credits-particle-float 3.8s ease-in-out infinite 1.5s;
  background: rgba(255, 105, 180, 0.5);
  box-shadow: 0 0 12rpx rgba(255, 105, 180, 0.4);
}
.credits-particle.p5 {
  left: 50%; top: 40%;
  animation: credits-particle-float 4.2s ease-in-out infinite 2s;
  width: 4rpx;
  height: 4rpx;
}
.credits-particle.p6 {
  left: 15%; top: 55%;
  animation: credits-particle-float 5.5s ease-in-out infinite 0.8s;
  background: rgba(100, 200, 255, 0.4);
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.3);
  width: 4rpx;
  height: 4rpx;
}

@keyframes credits-particle-float {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.3;
  }
  25% {
    transform: translate(20rpx, -30rpx) scale(1.2);
    opacity: 0.8;
  }
  50% {
    transform: translate(-10rpx, -50rpx) scale(0.8);
    opacity: 0.5;
  }
  75% {
    transform: translate(30rpx, -20rpx) scale(1.1);
    opacity: 0.7;
  }
}

/* ============================================
   第七部分：致敬墙 · 传承
   ============================================ */

.section-7 {
  position: relative;
  min-height: 100vh;
  height: auto;
  overflow: visible;
  background: linear-gradient(180deg, #0a0a14 0%, #100c1a 30%, #0a0f1a 60%, #0a0a14 100%);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

/* ====== 致敬墙区域 ====== */
.tribute-section {
  flex: 1;
  padding: 48rpx 32rpx 0;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.8s ease;
}

.tribute-section.active {
  opacity: 1;
  transform: translateY(0);
}

/* 顶部菱形装饰 */
.tribute-deco-top {
