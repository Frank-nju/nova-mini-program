  font-size: 16rpx;
  font-weight: 700;
  color: rgba(201, 169, 110, 0.6);
  background: rgba(201, 169, 110, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

/* 卡片信息区 */
.works-card-info {
  padding: 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.works-card-title {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(240, 230, 210, 0.95);
  letter-spacing: 1rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.works-card-author-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.works-card-author-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.5);
  flex-shrink: 0;
}

.works-card-author {
  font-size: 20rpx;
  color: rgba(201, 169, 110, 0.55);
  letter-spacing: 1rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 列表视图（视频/文档） */
.works-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 24rpx;
}

.works-list-card {
  display: flex;
  align-items: center;
  background: rgba(30, 30, 48, 0.75);
  border: 1rpx solid rgba(201, 169, 110, 0.1);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  gap: 20rpx;
  backdrop-filter: blur(12rpx);
  transition: all 0.25s;
}

.works-list-card:active {
  border-color: rgba(201, 169, 110, 0.3);
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.works-list-video-thumb {
  width: 160rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #141428, #1e2840);
  border-radius: 12rpx;
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.works-list-video-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(100, 200, 255, 0.1), transparent 70%);
}

.works-list-play-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(100, 200, 255, 0.15);
  border: 2rpx solid rgba(100, 200, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(100, 200, 255, 0.7);
  position: relative;
  z-index: 1;
  margin-left: 3rpx;
}

.works-list-doc-thumb {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.1), rgba(201, 169, 110, 0.04));
  border-radius: 14rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.works-list-doc-icon-inner {
  font-size: 36rpx;
  opacity: 0.5;
}

.works-list-link-thumb {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, rgba(100, 200, 255, 0.08), rgba(201, 169, 110, 0.05));
  border-radius: 14rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
}

.works-list-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.works-list-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(240, 230, 210, 0.9);
  letter-spacing: 1rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.works-list-author-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.works-list-author-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.5);
  flex-shrink: 0;
}

.works-link-url {
  font-size: 18rpx;
  color: #64c8ff;
  opacity: 0.5;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.works-link-arrow {
  font-size: 36rpx;
  color: rgba(201, 169, 110, 0.35);
  flex-shrink: 0;
  line-height: 1;
}

/* === 漫画卡片 === */
.works-manga-card {
  border-color: rgba(201, 169, 110, 0.2);
}

.works-card-manga-cover {
  width: 100%;
  height: 280rpx;
  background: rgba(15, 15, 30, 0.9);
  position: relative;
  overflow: hidden;
}

.works-card-manga-img {
  width: 100%;
  height: 280rpx;
}

.works-card-manga-placeholder {
  width: 100%;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(201, 169, 110, 0.08), rgba(201, 169, 110, 0.02));
  position: relative;
}

.works-manga-page-count {
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  background: rgba(0, 0, 0, 0.75);
  color: rgba(201, 169, 110, 0.9);
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(201, 169, 110, 0.2);
}

.works-manga-title {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(240, 230, 210, 0.95);
  letter-spacing: 1rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.works-manga-author {
  font-size: 20rpx;
  color: rgba(201, 169, 110, 0.55);
  letter-spacing: 1rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* === 漫画阅读器弹窗 === */
/* (已移至 subpkg/pages/manga-viewer) */
/* ========== 全屏数字人面板 ========== */
.ai-panel-fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  overflow: hidden;
}

.ai-digital-human-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: #0A0A0F;
}

.ai-digital-human-bg digital-human {
  width: 100%;
  height: 100%;
}

.ai-fullscreen-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding: 40rpx 24rpx 0;
  display: flex;
  justify-content: flex-end;
  z-index: 100;
  background: linear-gradient(180deg, rgba(10, 10, 15, 0.8) 0%, transparent 100%);
}

.ai-close-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  backdrop-filter: blur(10rpx);
  font-size: 32rpx;
  color: #fff;
}

.ai-messages-float {
  position: absolute;
  bottom: 200rpx;
  left: 0;
  right: 0;
  height: 35vh;
  z-index: 10;
  padding: 0 24rpx;
}

.ai-float-msg {
  display: flex;
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.ai-float-user {
  justify-content: flex-end;
}

.ai-float-ai {
  justify-content: flex-start;
  flex-direction: column;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.ai-float-bubble {
  max-width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(20rpx);
  font-size: 26rpx;
  line-height: 1.6;
}

.ai-float-bubble.user {
  background: rgba(30, 58, 95, 0.85);
  border: 1rpx solid rgba(100, 180, 255, 0.2);
  color: rgba(255, 255, 255, 0.95);
}

.ai-float-bubble.ai {
  background: rgba(30, 30, 45, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.95);
}

.ai-float-audio-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-top: 12rpx;
  background: rgba(100, 180, 255, 0.2);
  border-radius: 26rpx;
  border: 1rpx solid rgba(100, 180, 255, 0.3);
  font-size: 22rpx;
  color: #64b4ff;
}

.ai-float-audio-btn.playing {
  background: rgba(100, 180, 255, 0.4);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.ai-bottom-float {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(10, 10, 15, 0.95) 0%, rgba(10, 10, 15, 0.7) 60%, transparent 100%);
  z-index: 100;
}

.ai-presets-float {
  margin-bottom: 16rpx;
}

.ai-presets-scroll {
  white-space: nowrap;
}

.ai-presets-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx;
}

.ai-preset-chip-float {
  display: inline-flex;
  padding: 14rpx 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  backdrop-filter: blur(10rpx);
}

.ai-preset-chip-float text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

.ai-input-float {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(30, 30, 45, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 44rpx;
  backdrop-filter: blur(20rpx);
}

.ai-input-field {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #fff;
  background: transparent;
}

.ai-input-field::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.ai-send-float {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #1e3a5f, #0f2847);
  border-radius: 28rpx;
}

.ai-send-float.disabled {
  opacity: 0.5;
}

.ai-send-float text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* ====== 用户致敬留言区域 ====== */
.user-tribute-section {
  padding: 32rpx 32rpx 0;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.8s ease 0.15s;
}

.user-tribute-section.active {
  opacity: 1;
  transform: translateY(0);
}

.user-tribute-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.user-tribute-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: rgba(232, 200, 140, 0.9);
  letter-spacing: 8rpx;
}

.user-tribute-header-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(232, 200, 140, 0.55), transparent);
  margin: 16rpx auto;
}

.user-tribute-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(232, 200, 140, 0.5);
  letter-spacing: 4rpx;
}

.tribute-input-card {
  background: rgba(30, 28, 20, 0.7);
  border: 1rpx solid rgba(201, 169, 110, 0.28);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 0 20rpx rgba(201, 169, 110, 0.06);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.tribute-input-card.input-focused {
  border-color: rgba(232, 200, 140, 0.55);
  box-shadow: 0 0 24rpx rgba(201, 169, 110, 0.12);
}

.tribute-textarea {
  width: 100%;
  min-height: 140rpx;
  max-height: 300rpx;
  font-size: 26rpx;
  color: rgba(240, 237, 230, 0.9);
  line-height: 1.8;
  background: transparent;
}

.tribute-placeholder {
  color: rgba(201, 169, 110, 0.38);
  font-size: 26rpx;
}

.tribute-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(201, 169, 110, 0.13);
}

.tribute-char-count {
  font-size: 20rpx;
  color: rgba(201, 169, 110, 0.4);
}

.tribute-submit-btn {
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(232, 200, 140, 0.6);
  background: rgba(201, 169, 110, 0.12);
  border: 1rpx solid rgba(201, 169, 110, 0.25);
  transition: all 0.25s ease;
}

.tribute-submit-btn::after {
  border: none;
}

.tribute-submit-btn.btn-active {
  color: #2a1f00;
  background: linear-gradient(135deg, #f0d66e, #d4a843);
  border-color: rgba(240, 210, 100, 0.6);
  box-shadow: 0 0 20rpx rgba(220, 170, 60, 0.35), 0 0 40rpx rgba(200, 150, 50, 0.15);
}

.tribute-submit-btn.btn-disabled {
  opacity: 0.35;
}

.user-tribute-list {
  margin-bottom: 16rpx;
}

.user-tribute-card {
  background: rgba(26, 26, 40, 0.5);
  border: 1rpx solid rgba(100, 200, 255, 0.08);
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  opacity: 0;
  transform: translateY(24rpx);
  transition: all 0.5s ease;
}

.user-tribute-card.card-visible {
  opacity: 1;
  transform: translateY(0);
}

.user-tribute-card-body {
  padding: 22rpx 24rpx 20rpx;
}

.user-tribute-card-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.user-tribute-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(100, 200, 255, 0.08);
  border: 1rpx solid rgba(100, 200, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.user-tribute-avatar-img {
  width: 100%;
  height: 100%;
}

.user-tribute-avatar-text {
  font-size: 22rpx;
}

.user-tribute-meta {
  margin-left: 14rpx;
  flex: 1;
}

.user-tribute-nickname {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(100, 200, 255, 0.6);
}

.user-tribute-time {
  display: block;
  font-size: 18rpx;
  color: rgba(100, 200, 255, 0.25);
  margin-top: 4rpx;
}

.user-tribute-message {
  display: block;
  font-size: 26rpx;
  color: rgba(240, 237, 230, 0.7);
  line-height: 1.85;
  letter-spacing: 1rpx;
  padding-left: 8rpx;
  border-left: 3rpx solid rgba(100, 200, 255, 0.12);
}

.user-tribute-loadmore {
  text-align: center;
  padding: 20rpx 0;
}

.user-tribute-loadmore text {
  font-size: 24rpx;
  color: rgba(100, 200, 255, 0.35);
}

.user-tribute-end {
  text-align: center;
  padding: 24rpx 0;
}

.user-tribute-end text {
  font-size: 22rpx;
  color: rgba(100, 200, 255, 0.2);
  letter-spacing: 4rpx;
}

.user-tribute-empty {
  text-align: center;
  padding: 40rpx 0 48rpx;
}

.user-tribute-empty text {
  font-size: 24rpx;
  color: rgba(201, 169, 110, 0.2);
}
