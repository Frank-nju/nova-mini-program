  font-size: 26rpx;
  color: rgba(240, 237, 230, 0.8);
  line-height: 1.9;
  letter-spacing: 1rpx;
}

/* 作者信息区 */
.tribute-author {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(201, 169, 110, 0.08);
}

.tribute-author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.08);
  border: 1rpx solid rgba(201, 169, 110, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.tribute-author-info {
  margin-left: 14rpx;
}

.tribute-author-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(201, 169, 110, 0.65);
}

.tribute-author-role {
  display: block;
  font-size: 18rpx;
  color: rgba(201, 169, 110, 0.35);
  margin-top: 4rpx;
}

/* 致敬墙与传承之间的过渡 */
.tribute-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0 24rpx;
}

.tribute-divider-line {
