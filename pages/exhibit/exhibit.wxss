  content: '';
  position: absolute;
  width: 200%;
  height: 200%;
  background:
    linear-gradient(135deg, transparent 40%, rgba(100, 200, 255, 0.04) 41%, rgba(100, 200, 255, 0.04) 42%, transparent 43%),
    linear-gradient(135deg, transparent 60%, rgba(201, 169, 110, 0.03) 61%, rgba(201, 169, 110, 0.03) 62%, transparent 63%),
    linear-gradient(135deg, transparent 20%, rgba(255, 105, 180, 0.03) 21%, rgba(255, 105, 180, 0.03) 22%, transparent 23%);
