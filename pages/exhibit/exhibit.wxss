  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.25));
}

.tribute-divider-line:last-child {
  background: linear-gradient(90deg, rgba(201, 169, 110, 0.25), transparent);
}

.tribute-divider-star {
  margin: 0 16rpx;
  font-size: 18rpx;
  color: rgba(201, 169, 110, 0.35);
}

/* ====== 传承时间线区域 ====== */
.legacy-section {
  padding: 24rpx 32rpx 0;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.8s ease 0.3s;
}

.legacy-section.active {
  opacity: 1;
  transform: translateY(0);
}

.legacy-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.legacy-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: rgba(100, 200, 255, 0.75);
