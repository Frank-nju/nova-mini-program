  bottom: 0;
  width: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(to bottom,
    rgba(100, 200, 255, 0.05) 0%,
    rgba(100, 200, 255, 0.15) 10%,
    rgba(100, 200, 255, 0.5) 50%,
    rgba(100, 200, 255, 0.15) 90%,
    rgba(100, 200, 255, 0.05) 100%
  );
}

.legacy-item {
  position: relative;
  margin-bottom: 32rpx;
  opacity: 0;
  transform: translateX(24rpx);
  transition: all 0.6s ease;
}

.legacy-item.item-visible {
  opacity: 1;
  transform: translateX(0);
}

/* 时间线圆点（双层） */
.legacy-dot-wrap {
  position: absolute;
  left: -40rpx;
  top: 28rpx;
