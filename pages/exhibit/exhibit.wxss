}

/* 卡片右上角装饰角 */
.tribute-card-corner {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 24rpx;
  height: 24rpx;
  border-top: 1rpx solid rgba(201, 169, 110, 0.2);
  border-right: 1rpx solid rgba(201, 169, 110, 0.2);
  border-radius: 0 8rpx 0 0;
}

.tribute-card-body {
  padding: 28rpx 28rpx 24rpx 36rpx;
}

/* 引用主体 */
.tribute-quote-main {
  position: relative;
  padding-left: 24rpx;
}

.tribute-quote-mark {
  position: absolute;
  top: -8rpx;
  left: -4rpx;
