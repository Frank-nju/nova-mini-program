  background:
    radial-gradient(ellipse at 20% 0%, rgba(20, 60, 120, 0.4) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 100%, rgba(120, 40, 80, 0.2) 0%, transparent 50%),
    linear-gradient(170deg, #0a0e1a 0%, #0c1020 30%, #101028 60%, #0e0e20 100%);
  overflow-y: auto;
}

/* 面板顶部彩色光带 */
.quiz-panel::before {
  content: '';
  position: absolute;
  top: -2rpx;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #64c8ff, #c9a96e, #ffd700, #ff69b4, #64c8ff);
  background-size: 200% 100%;
  animation: quiz-gradient-move 4s linear infinite;
  z-index: 10;
  pointer-events: none;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 2rpx 20rpx rgba(100, 200, 255, 0.4);
}

@keyframes quiz-gradient-move {
  0% { background-position: 0% 0%; }
  100% { background-position: 200% 0%; }
}

/* 背景装饰 - 多层极光效果 */
.quiz-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(ellipse at 10% 10%, rgba(100, 200, 255, 0.08) 0%, transparent 45%),
    radial-gradient(ellipse at 90% 20%, rgba(201, 169, 110, 0.06) 0%, transparent 40%),
    radial-gradient(ellipse at 30% 80%, rgba(255, 105, 180, 0.05) 0%, transparent 35%),
