.scene-universe {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 200rpx;
}

.nebula {
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.4;
}

.nebula-1 {
  background: rgba(100, 200, 255, 0.3);
  animation: nebula-breath 4s ease-in-out infinite;
}

.nebula-2 {
  background: rgba(255, 105, 180, 0.2);
  animation: nebula-breath 5s ease-in-out infinite 0.5s;
}

@keyframes nebula-breath {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.light-beam {
  position: absolute;
  width: 4rpx;
  height: 600rpx;
  background: linear-gradient(to bottom, rgba(100, 200, 255, 0.3), transparent);
  left: 50%;
  top: 10%;
  transform: translateX(-50%);
  animation: beam-pulse 3s ease-in-out infinite;
}

@keyframes beam-pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.7; }
}

/* 粒子效果 */
.particles-section {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 0;
}

@keyframes float-up {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) translateX(50px);
    opacity: 0;
  }
}

@keyframes float-up-reverse {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) translateX(-50px);
    opacity: 0;
  }
}

.particle-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(100, 200, 255, 0.6);
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.4);
}

.particle-dot:nth-child(odd) {
  animation: float-up 12s linear infinite;
  width: 2rpx;
  height: 2rpx;
  left: calc(15% + 20rpx * var(--i));
  background: rgba(201, 169, 110, 0.5);
}

.particle-dot:nth-child(even) {
  animation: float-up-reverse 14s linear infinite;
  width: 3rpx;
  height: 3rpx;
  right: calc(15% + 30rpx * var(--i));
  background: rgba(255, 105, 180, 0.4);
}

/* === 卷轴样式 === */
.section-content {
  position: absolute;
  z-index: 11;
  text-align: center;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 100rpx;
  pointer-events: none;
}

.scroll-hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #64c8ff;
  opacity: 0.7;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(20rpx);
  }
}

/* 卷轴容器 */
.scroll-container {
  width: 100%;
  height: 60%;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1200px;
}

/* 通用卷轴 */
.scroll-item {
  position: relative;
  width: 300rpx;
  height: 420rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  cursor: pointer;
  animation: scroll-float 3s ease-in-out infinite;
}

@keyframes scroll-float {
  0%, 100% {
    transform: translateY(0) rotateZ(0deg);
  }
  50% {
    transform: translateY(-25rpx) rotateZ(1deg);
  }
}

.scroll-item:active {
  transform: scale(0.95) !important;
}

.scroll-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 20rpx;
  box-shadow: 0 0 60rpx rgba(100, 200, 255, 0.3), inset 0 0 60rpx rgba(100, 200, 255, 0.05);
  z-index: 1;
  pointer-events: none;
}

.scroll-frame {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
}

.frame-top, .frame-bottom, .frame-left, .frame-right {
  position: absolute;
  background: linear-gradient(90deg, rgba(100, 200, 255, 0.5), transparent);
  animation: frame-glow 2s ease-in-out infinite;
}

.frame-top {
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(100, 200, 255, 0.6), transparent);
}

.frame-bottom {
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.6), transparent);
}

.frame-left {
  top: 0;
  left: 0;
  width: 2rpx;
  bottom: 0;
  background: linear-gradient(180deg, rgba(100, 200, 255, 0.4), transparent);
}

.frame-right {
  top: 0;
  right: 0;
  width: 2rpx;
  bottom: 0;
  background: linear-gradient(180deg, rgba(201, 169, 110, 0.4), transparent);
}

@keyframes frame-glow {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

/* 晶体卷轴（序章） */
.scroll-crystal {
  background: linear-gradient(135deg, rgba(64, 120, 180, 0.6) 0%, rgba(30, 60, 120, 0.8) 100%);
  border: 2rpx solid rgba(100, 200, 255, 0.6);
  backdrop-filter: blur(20px);
}

.scroll-crystal .scroll-content {
  background: radial-gradient(circle at 30% 30%, rgba(100, 200, 255, 0.3), transparent);
}

/* 书籍卷轴（生平履历） */
.scroll-book {
  background: linear-gradient(135deg, rgba(80, 60, 40, 0.6) 0%, rgba(40, 30, 20, 0.8) 100%);
  border: 2rpx solid rgba(201, 169, 110, 0.5);
  backdrop-filter: blur(20px);
}

.book-pages {
  position: absolute;
  width: 200rpx;
  height: 280rpx;
  background: repeating-linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.05) 0,
    rgba(255, 255, 255, 0.05) 10rpx,
    transparent 10rpx,
    transparent 20rpx
  );
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  border: 1rpx solid rgba(201, 169, 110, 0.3);
  border-radius: 4rpx;
}

/* 传统卷轴（治学风骨） */
.scroll-scroll {
  background: linear-gradient(135deg, rgba(100, 80, 60, 0.6) 0%, rgba(50, 40, 30, 0.8) 100%);
  border: 3rpx solid rgba(201, 169, 110, 0.6);
  backdrop-filter: blur(20px);
}

.scroll-roll-left, .scroll-roll-right {
  position: absolute;
  width: 40rpx;
  height: 280rpx;
  background: linear-gradient(90deg, rgba(101, 84, 68, 0.8), rgba(101, 84, 68, 0.5));
  border: 1rpx solid rgba(201, 169, 110, 0.4);
  border-radius: 20rpx;
  z-index: 1;
  top: 50%;
  transform: translateY(-50%);
}

.scroll-roll-left {
  left: 20rpx;
}

.scroll-roll-right {
  right: 20rpx;
}

/* 实验室卷轴（科研丰碑） */
.scroll-lab {
  background: linear-gradient(135deg, rgba(60, 100, 120, 0.6) 0%, rgba(30, 60, 80, 0.8) 100%);
  border: 2rpx solid rgba(100, 200, 255, 0.5);
  backdrop-filter: blur(20px);
}

.reactor-core {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  background: radial-gradient(circle at 35% 35%, rgba(255, 100, 100, 0.8), rgba(255, 100, 100, 0.2), transparent);
  border-radius: 50%;
  box-shadow: 0 0 40rpx rgba(255, 100, 100, 0.4), inset 0 0 40rpx rgba(255, 100, 100, 0.2);
  animation: reactor-pulse 2s ease-in-out infinite;
}

@keyframes reactor-pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
  50% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
}

/* 宇宙卷轴（尾声） */
.scroll-universe {
  background: linear-gradient(135deg, rgba(40, 30, 80, 0.6) 0%, rgba(20, 10, 40, 0.8) 100%);
  border: 2rpx solid rgba(100, 200, 255, 0.5);
  backdrop-filter: blur(20px);
}

.universe-orb {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 0;
  background: radial-gradient(circle at 35% 35%, rgba(100, 200, 255, 0.9), rgba(100, 200, 255, 0.3), transparent);
  border-radius: 50%;
  box-shadow: 0 0 60rpx rgba(100, 200, 255, 0.5), inset 0 0 60rpx rgba(100, 200, 255, 0.3);
  animation: universe-spin 4s linear infinite;
}

@keyframes universe-spin {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.scroll-content {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scroll-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #f0ede6;
  text-shadow: 0 0 20rpx rgba(100, 200, 255, 0.4);
}

.scroll-desc {
  display: block;
  font-size: 26rpx;
  color: #c9a96e;
  opacity: 0.9;
}

.scroll-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent,
    rgba(255, 255, 255, 0.15),
    transparent
  );
  animation: shine-sweep 3s infinite;
  pointer-events: none;
}

@keyframes shine-sweep {
  0% {
    transform: translateX(-100%) translateY(-100%);
  }
  100% {
    transform: translateX(100%) translateY(100%);
  }
}

/* === 常驻按钮栏 === */
.floating-buttons {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 200;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #0a0a0f;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 30rpx currentColor;
}

.float-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.4), transparent);
  animation: pulse-ring 2s infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}

.float-btn:active {
  transform: scale(0.85);
}

.btn-clouds {
  background: linear-gradient(135deg, #64c8ff 0%, #4a88c8 100%);
  border-color: rgba(100, 200, 255, 0.8);
  color: #0a0a0f;
}

.btn-badge {
  background: linear-gradient(135deg, #ffd700 0%, #daa520 100%);
  border-color: rgba(255, 215, 0, 0.8);
  color: #0a0a0f;
}

.btn-quiz {
  background: linear-gradient(135deg, #20b2aa 0%, #008080 100%);
  border-color: rgba(32, 178, 170, 0.8);
  color: #fff;
}

.btn-ai {
  background: linear-gradient(135deg, #ff69b4 0%, #ff1493 100%);
  border-color: rgba(255, 105, 180, 0.8);
  color: #fff;
}

.btn-materials {
  background: linear-gradient(135deg, #20b2aa 0%, #008080 100%);
  border-color: rgba(32, 178, 170, 0.8);
  color: #fff;
}

.btn-more {
  background: linear-gradient(135deg, #9370db 0%, #6a4c93 100%);
  border-color: rgba(147, 112, 219, 0.8);
  color: #fff;
}

.badge-dot {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: #ff6347;
  border-radius: 50%;
  border: 2rpx solid #0a0a0f;
  z-index: 3;
  animation: badge-pulse 1s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 12rpx #ff6347;
  }
  50% {
    transform: scale(1.2);
    box-shadow: 0 0 24rpx #ff6347;
  }
}

/* === 徽章弹出通知样式 === */
.badge-notification {
  position: fixed;
  top: 150rpx;
  left: 50%;
  z-index: 1000;
  transform: translateX(-50%);
  pointer-events: none;
}

.notification-content {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 40rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.95) 0%, rgba(218, 165, 32, 0.9) 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 215, 0, 1);
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.6), 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(20px);
}

.notification-icon {
  font-size: 48rpx;
  line-height: 48rpx;
}

.notification-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.notification-title {
  font-size: 20rpx;
  color: rgba(10, 10, 15, 0.8);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.notification-name {
  font-size: 28rpx;
  color: #0a0a0f;
  font-weight: 700;
  text-shadow: 0 2px 4px rgba(255, 255, 255, 0.3);
}

/* === 故事完成通知 === */
.story-complete-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 48rpx 64rpx;
  background: rgba(10, 10, 20, 0.92);
  border-radius: 24rpx;
  border: 2rpx solid rgba(100, 200, 255, 0.4);
  box-shadow: 0 0 60rpx rgba(100, 200, 255, 0.3), 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(20px);
}

.story-complete-icon {
  font-size: 64rpx;
  color: #64c8ff;
  font-weight: 700;
  text-shadow: 0 0 30rpx rgba(100, 200, 255, 0.8);
  line-height: 1;
}

.story-complete-title {
  font-size: 26rpx;
  color: rgba(240, 230, 211, 0.9);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.story-complete-text {
  font-size: 22rpx;
  color: rgba(100, 200, 255, 0.7);
  letter-spacing: 2rpx;
}

@keyframes storyCompletePop {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
  20% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
  40% { transform: translate(-50%, -50%) scale(1); }
  80% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -60%) scale(0.95); }
}

/* === 面板样式 === */
.panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 70vh;
  background: rgba(10, 10, 15, 0.98);
  border-top: 2rpx solid rgba(100, 200, 255, 0.5);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx 32rpx;
  z-index: 300;
  animation: slide-up-panel 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  backdrop-filter: blur(40px);
  box-shadow: 0 -20rpx 60rpx rgba(100, 200, 255, 0.2);
  overflow-y: auto;
}

@keyframes slide-up-panel {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(100, 200, 255, 0.3);
}

.panel-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #f0ede6;
  text-shadow: 0 0 20rpx rgba(100, 200, 255, 0.3);
}

.close-btn {
  font-size: 44rpx;
  color: #64c8ff;
  cursor: pointer;
  transition: all 0.3s ease;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-btn:active {
  transform: rotate(90deg) scale(0.7);
}

/* === 云图面板 === */
.clouds-panel {
  bottom: 0;
}

.clouds-panel[hidden] {
  display: none !important;
}

.cloud-map-container {
  width: 100%;
  height: 500rpx;
  position: relative;
}

.cloud-canvas {
  width: 100%;
  height: 100%;
  background: rgba(20, 20, 40, 0.6);
  border: 1rpx solid rgba(100, 200, 255, 0.3);
  border-radius: 16rpx;
  display: block;
}

/* 云图信息框 */
.cloud-info-box {
  position: absolute;
  bottom: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 15, 0.95);
  border: 2rpx solid rgba(100, 200, 255, 0.5);
  border-radius: 12rpx;
  padding: 20rpx;
  min-width: 280rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 8px 32px rgba(100, 200, 255, 0.2);
  animation: info-fade-in 0.3s ease-out;
  z-index: 60;
}

@keyframes info-fade-in {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.cloud-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.cloud-info-title {
  font-size: 28rpx;
  color: #ffd700;
  font-weight: 700;
}

.cloud-info-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #c9a96e;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.cloud-info-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.cloud-legend {
  display: flex;
  gap: 40rpx;
  justify-content: center;
  margin-top: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-shadow: 0 0 8rpx currentColor;
}

.legend-item text {
  font-size: 24rpx;
  color: #c9a96e;
}

/* === 徽章系统 === */
.badges-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(255, 215, 0, 0.08);
  border: 1rpx solid rgba(255, 215, 0, 0.4);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.badge-item:active {
  transform: scale(0.95);
  background: rgba(255, 215, 0, 0.15);
}

.badge-icon {
  font-size: 64rpx;
  animation: icon-float 2s ease-in-out infinite;
}

.badge-name {
  font-size: 22rpx;
  color: #e8d5a8;
  font-weight: 600;
}

@keyframes icon-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

/* 徽章重置按钮 */
.badge-reset-wrap {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.badge-reset-btn {
  padding: 12rpx 48rpx;
  background: rgba(255, 100, 100, 0.1);
  border: 1rpx solid rgba(255, 100, 100, 0.3);
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.badge-reset-btn text {
  font-size: 24rpx;
  color: rgba(255, 100, 100, 0.7);
  font-weight: 500;
}

.badge-reset-btn:active {
  background: rgba(255, 100, 100, 0.2);
  border-color: rgba(255, 100, 100, 0.5);
}

/* ====== 数字人面板 ====== */
.ai-panel {
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden !important;
  height: 60vh;
  max-height: 60vh;
  padding: 0;
}

.ai-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(ellipse at top, rgba(100, 200, 255, 0.05) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  position: relative;
  z-index: 1;
}

.ai-header-left {
  display: flex;
  align-items: center;
}

.ai-avatar-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 聊天消息滚动区 */
.ai-messages-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
  min-height: 400rpx;
}

.ai-messages-container {
  padding: 0 24rpx 16rpx;
}

/* 消息行 */
.ai-msg {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.ai-msg-welcome {
  align-items: flex-start;
}

.ai-msg-user {
  flex-direction: row-reverse;
}

.ai-msg-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(100, 200, 255, 0.08);
  border: 1rpx solid rgba(100, 200, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  margin: 4rpx 0;
}

.ai-msg-user .ai-msg-avatar {
  margin-left: 16rpx;
}

.ai-msg-ai .ai-msg-avatar {
  margin-right: 16rpx;
}

.ai-msg-bubble {
  max-width: 75%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  position: relative;
}

.user-bubble {
  background: linear-gradient(135deg, #1e3a5f, #0f2847);
  color: rgba(240, 237, 230, 0.9);
  border: 1rpx solid rgba(100, 200, 255, 0.15);
  border-bottom-right-radius: 6rpx;
  margin-right: 4rpx;
}

.ai-bubble {
  background: rgba(26, 26, 40, 0.7);
  color: rgba(240, 237, 230, 0.8);
  border: 1rpx solid rgba(100, 200, 255, 0.08);
  border-bottom-left-radius: 6rpx;
  margin-left: 4rpx;
}

.ai-loading-bubble {
  min-width: 100rpx;
}

/* 打字动画点 */
.ai-typing-dots {
  display: inline-flex;
  gap: 6rpx;
  align-items: center;
  height: 26rpx;
}

.ai-typing-dots text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(100, 200, 255, 0.4);
  animation: typing-bounce 1.4s infinite;
}

.ai-typing-dots text:nth-child(2) {
  animation-delay: 0.2s;
}

.ai-typing-dots text:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing-bounce {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* 预设问题 */
.ai-presets {
  padding: 16rpx 24rpx 12rpx;
  position: relative;
  z-index: 1;
}

.ai-presets-label {
  display: block;
  font-size: 20rpx;
  color: rgba(200, 200, 220, 0.4);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.ai-preset-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ai-preset-chip {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(100, 200, 255, 0.2);
  background: rgba(100, 200, 255, 0.06);
  font-size: 22rpx;
  color: rgba(100, 200, 255, 0.7);
  transition: all 0.2s;
}

.ai-preset-chip:active {
  border-color: rgba(100, 200, 255, 0.5);
  background: rgba(100, 200, 255, 0.12);
}

/* 输入区 */
.ai-input-area {
  padding: 12rpx 24rpx 20rpx;
  position: relative;
  z-index: 1;
}

.ai-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-input {
  flex: 1;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(100, 200, 255, 0.2);
  background: rgba(26, 26, 40, 0.6);
  color: rgba(240, 237, 230, 0.85);
  font-size: 26rpx;
}

.ai-input[disabled] {
  opacity: 0.5;
}

.ai-send-btn {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1e3a5f, #0f2847);
  border: 1rpx solid rgba(100, 200, 255, 0.3);
  color: rgba(100, 200, 255, 0.85);
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.ai-send-btn.disabled {
  opacity: 0.4;
  border-color: rgba(100, 200, 255, 0.1);
}

.ai-send-btn:active:not(.disabled) {
  background: linear-gradient(135deg, #2a4a7f, #1a3860);
}

/* 粒子效果 */
.particles-section {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 0;
}

@keyframes float-up {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) translateX(50px);
    opacity: 0;
  }
}

@keyframes float-up-reverse {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) translateX(-50px);
    opacity: 0;
  }
}

.particle-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(100, 200, 255, 0.6);
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.4);
}

.particle-dot:nth-child(odd) {
  animation: float-up 12s linear infinite;
  width: 2rpx;
  height: 2rpx;
  left: calc(15% + 20rpx * var(--i));
  background: rgba(201, 169, 110, 0.5);
}

.particle-dot:nth-child(even) {
  animation: float-up-reverse 14s linear infinite;
  width: 3rpx;
  height: 3rpx;
  right: calc(15% + 30rpx * var(--i));
  background: rgba(255, 105, 180, 0.4);
}

/* 部分内容 */
.section-content {
  position: relative;
  z-index: 10;
  text-align: center;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.section-title {
  font-size: 96rpx;
  font-weight: 700;
  color: #f0ede6;
  text-shadow: 0 0 40rpx rgba(100, 200, 255, 0.3), 0 0 80rpx rgba(201, 169, 110, 0.2);
  letter-spacing: 12rpx;
  animation: title-pulse 2s ease-in-out infinite;
}

@keyframes title-pulse {
  0%, 100% {
    text-shadow: 0 0 40rpx rgba(100, 200, 255, 0.3), 0 0 80rpx rgba(201, 169, 110, 0.2);
    transform: scale(1);
  }
  50% {
    text-shadow: 0 0 60rpx rgba(100, 200, 255, 0.5), 0 0 100rpx rgba(201, 169, 110, 0.3);
    transform: scale(1.02);
  }
}

.scroll-hint {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #64c8ff;
  opacity: 0.7;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(20rpx);
  }
}

/* 卷轴容器 */
.scroll-container {
  width: 100%;
  height: 60%;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
}

.scroll-item {
  position: relative;
  width: 280rpx;
  height: 400rpx;
  background: linear-gradient(135deg, rgba(50, 50, 70, 0.9) 0%, rgba(30, 30, 50, 0.95) 100%);
  border: 2rpx solid rgba(100, 200, 255, 0.5);
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 40rpx rgba(100, 200, 255, 0.2), inset 0 0 40rpx rgba(100, 200, 255, 0.05);
  backdrop-filter: blur(10px);
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  cursor: pointer;
  animation: scroll-float 3s ease-in-out infinite;
}

@keyframes scroll-float {
  0%, 100% {
    transform: translateY(0) rotateZ(0deg);
  }
  50% {
    transform: translateY(-20rpx) rotateZ(2deg);
  }
}

.scroll-item::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent,
    rgba(255, 255, 255, 0.1),
    transparent
  );
  animation: shine-scroll 3s infinite;
}

@keyframes shine-scroll {
  0% {
    transform: translateX(-100%) translateY(-100%);
  }
  100% {
    transform: translateX(100%) translateY(100%);
  }
}

.scroll-item:active {
  transform: scale(0.95);
  box-shadow: 0 0 60rpx rgba(100, 200, 255, 0.4), inset 0 0 60rpx rgba(100, 200, 255, 0.1);
}

.scroll-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #f0ede6;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
}

.scroll-desc {
  display: block;
  font-size: 26rpx;
  color: #64c8ff;
  position: relative;
  z-index: 2;
}

/* 常驻按钮栏 */
.floating-buttons {
  position: fixed;
  right: 32rpx;
  bottom: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 200;
}

.float-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #64c8ff 0%, #4a88c8 100%);
  border: 2rpx solid rgba(100, 200, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #0a0a0f;
  box-shadow: 0 0 20rpx rgba(100, 200, 255, 0.4);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.float-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3), transparent);
  animation: pulse-ring 2s infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}

.float-btn:active {
  transform: scale(0.9);
}

.btn-clouds {
  background: linear-gradient(135deg, #64c8ff 0%, #4a88c8 100%);
}

.btn-badge {
  background: linear-gradient(135deg, #ffd700 0%, #daa520 100%);
}

.btn-ai {
  background: linear-gradient(135deg, #ff69b4 0%, #ff1493 100%);
}

.btn-more {
  background: linear-gradient(135deg, #9370db 0%, #6a4c93 100%);
}

.badge-dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #ff6347;
  border-radius: 50%;
  border: 2rpx solid #0a0a0f;
  z-index: 3;
  animation: badge-pulse 1s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 10rpx #ff6347;
  }
  50% {
    transform: scale(1.2);
    box-shadow: 0 0 20rpx #ff6347;
  }
}

/* 面板样式 */
.panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 60vh;
  background: rgba(10, 10, 15, 0.98);
  border-top: 2rpx solid rgba(100, 200, 255, 0.3);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  z-index: 300;
  animation: slide-up-panel 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  backdrop-filter: blur(30px);
  box-shadow: 0 -10rpx 40rpx rgba(100, 200, 255, 0.15);
  overflow-y: auto;
}

@keyframes slide-up-panel {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(100, 200, 255, 0.2);
}

.panel-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0ede6;
}

.close-btn {
  font-size: 40rpx;
  color: #64c8ff;
  cursor: pointer;
  transition: all 0.3s ease;
}

.close-btn:active {
  transform: rotate(90deg) scale(0.8);
}

/* 事件云图 */
.clouds-container {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.cloud-item {
  flex: 0 0 calc(50% - 12rpx);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: rgba(100, 200, 255, 0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(100, 200, 255, 0.2);
  transition: all 0.3s ease;
}

.cloud-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  box-shadow: 0 0 12rpx currentColor;
}

.cloud-label {
  font-size: 24rpx;
  color: #e8d5a8;
  flex: 1;
}

/* 徽章系统 */
.badges-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(255, 215, 0, 0.08);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.badge-icon {
  font-size: 56rpx;
}

.badge-name {
  font-size: 20rpx;
  color: #e8d5a8;
}

/* 第一部分特殊样式 — 追光封面 */
.section-1 .section-bg-image {
  z-index: 0;
}

/* 封面文字层 — 左上方，避开右侧人物肖像 */
.cover-text-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 200rpx 60rpx 0;
  pointer-events: none;
}

.cover-title-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20rpx;
}

.cover-title {
  font-size: 100rpx;
  font-weight: 700;
  color: #f0e6d2;
  letter-spacing: 16rpx;
  text-shadow: 0 0 60rpx rgba(255, 220, 140, 0.4), 0 4px 20px rgba(0, 0, 0, 0.6);
  line-height: 1;
  margin-left: -12rpx;
}

.cover-title-line {
  width: 80rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #c9a96e, transparent);
  margin: 8rpx 0 8rpx 12rpx;
  animation: line-expand 1.5s ease-out 0.5s both;
}

@keyframes line-expand {
  from { width: 0; opacity: 0; }
  to { width: 80rpx; opacity: 1; }
}

.cover-subtitle {
  font-size: 32rpx;
  color: #c9a96e;
  letter-spacing: 6rpx;
  font-weight: 500;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  margin-left: 16rpx;
}

.cover-hint {
  position: absolute;
  bottom: 120rpx;
  left: 60rpx;
  font-size: 24rpx;
  color: rgba(201, 169, 110, 0.6);
  letter-spacing: 4rpx;
  animation: hint-breathe 2.5s ease-in-out infinite;
}

@keyframes hint-breathe {
  0%, 100% { opacity: 0.4; transform: translateY(0); }
  50% { opacity: 0.8; transform: translateY(8rpx); }
}

/* ===== 封面制作团队 ===== */
/* ========== 赛博古风场景元素 ========== */

/* 序章-西学求索 */
.study-room-bg {
  position: absolute;
  width: 100%;
  height: 100%;
}

.desk-silhouette {
  position: absolute;
  left: 20%;
  bottom: 15%;
  width: 250rpx;
  height: 120rpx;
  background: linear-gradient(to right, rgba(100, 80, 50, 0.3), rgba(80, 60, 40, 0.5));
  border: 1rpx solid rgba(201, 169, 110, 0.2);
  border-radius: 8rpx;
  opacity: 0.4;
  animation: desk-float 4s ease-in-out infinite;
}

@keyframes desk-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

.lamp-silhouette {
  position: absolute;
  left: 25%;
  bottom: 35%;
  width: 80rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  animation: lamp-glow-pulse 2.5s ease-in-out infinite;
}

@keyframes lamp-glow-pulse {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.3); }
}

.lamp-base {
  width: 60rpx;
  height: 20rpx;
  background: rgba(100, 80, 60, 0.6);
  border-radius: 2rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.4);
}

.lamp-neck {
  width: 8rpx;
  height: 80rpx;
  background: linear-gradient(to top, rgba(100, 80, 60, 0.7), rgba(120, 100, 80, 0.6));
  margin: 8rpx 0;
  border-radius: 4rpx;
}

.lamp-head {
  position: relative;
  width: 60rpx;
  height: 40rpx;
  background: linear-gradient(180deg, rgba(240, 200, 100, 0.4), rgba(150, 120, 80, 0.6));
  border-radius: 50% 50% 30% 30%;
  border: 1rpx solid rgba(240, 200, 100, 0.5);
}

.lamp-glow {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(240, 200, 100, 0.5), transparent 70%);
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  filter: blur(25rpx);
  opacity: 0.6;
  animation: lamp-flicker 3s ease-in-out infinite;
}

@keyframes lamp-flicker {
  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.15); }
}

.dust-particles {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.dust-dot {
  position: absolute;
  width: 2rpx;
  height: 2rpx;
  background: rgba(240, 200, 100, 0.8);
  border-radius: 50%;
  box-shadow: 0 0 3rpx rgba(240, 200, 100, 0.6);
  animation: dust-float 4s ease-in-out infinite;
}

.dust-dot:nth-child(1) { left: 30%; top: 20%; animation-delay: 0s; }
.dust-dot:nth-child(2) { left: 50%; top: 15%; animation-delay: 0.3s; }
.dust-dot:nth-child(3) { left: 70%; top: 25%; animation-delay: 0.6s; }
.dust-dot:nth-child(4) { left: 25%; top: 50%; animation-delay: 0.9s; }
.dust-dot:nth-child(5) { left: 60%; top: 60%; animation-delay: 1.2s; }
.dust-dot:nth-child(6) { left: 40%; top: 75%; animation-delay: 1.5s; }
.dust-dot:nth-child(7) { left: 75%; top: 70%; animation-delay: 1.8s; }
.dust-dot:nth-child(8) { left: 20%; top: 80%; animation-delay: 2.1s; }
.dust-dot:nth-child(9) { left: 55%; top: 35%; animation-delay: 2.4s; }
.dust-dot:nth-child(10) { left: 85%; top: 50%; animation-delay: 2.7s; }
.dust-dot:nth-child(11) { left: 35%; top: 45%; animation-delay: 3s; }
.dust-dot:nth-child(12) { left: 65%; top: 55%; animation-delay: 3.3s; }
.dust-dot:nth-child(13) { left: 45%; top: 65%; animation-delay: 3.6s; }
.dust-dot:nth-child(14) { left: 80%; top: 35%; animation-delay: 3.9s; }
.dust-dot:nth-child(15) { left: 25%; top: 30%; animation-delay: 4.2s; }

@keyframes dust-float {
  0% {
    transform: translateY(0) translateX(0);
    opacity: 0;
  }
  20% {
    opacity: 1;
  }
  80% {
    opacity: 1;
  }
  100% {
    transform: translateY(-80rpx) translateX(30rpx);
    opacity: 0;
  }
}

.character-young-wu {
  position: absolute;
  right: 15%;
  top: 20%;
  width: 180rpx;
  height: 300rpx;
  z-index: 3;
}

.young-wu-silhouette {
  width: 100%;
  height: 100%;
  background: linear-gradient(to right, rgba(100, 150, 180, 0.25), transparent);
  border-radius: 50% 50% 40% 40%;
  filter: blur(2rpx);
  animation: wu-sway 5s ease-in-out infinite;
}

@keyframes wu-sway {
  0%, 100% { transform: translateX(0) rotate(0deg); }
  50% { transform: translateX(15rpx) rotate(1deg); }
}

.wu-aura {
  position: absolute;
  width: 250rpx;
  height: 350rpx;
  background: radial-gradient(ellipse at 50% 40%, rgba(100, 150, 180, 0.1), transparent 60%);
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  filter: blur(30rpx);
  animation: aura-pulse 3s ease-in-out infinite;
}

@keyframes aura-pulse {
  0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.6; transform: translate(-50%, -50%) scale(1.1); }
}

.scene-title {
  display: none !important;
}

/* 生平履历-孤行远方 */
.princeton-lab-bg {
  position: absolute;
  width: 100%;
  height: 100%;
}

.lab-equipment {
  position: absolute;
  left: 15%;
  bottom: 20%;
  width: 300rpx;
  height: 250rpx;
  display: flex;
  gap: 40rpx;
  align-items: flex-end;
}

.equipment-tube {
  width: 50rpx;
  height: 200rpx;
  border: 2rpx solid rgba(100, 200, 255, 0.4);
  border-radius: 0 0 20rpx 20rpx;
  background: linear-gradient(to bottom, transparent 30%, rgba(100, 200, 255, 0.1) 100%);
  position: relative;
  animation: tube-vibrate 2s ease-in-out infinite;
}

@keyframes tube-vibrate {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(1.05); }
}

.equipment-tube::after {
  content: '';
  position: absolute;
  bottom: 10%;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(to top, rgba(100, 200, 255, 0.3), transparent);
  animation: liquid-rise 3s ease-in-out infinite;
}

@keyframes liquid-rise {
  0%, 100% { height: 30%; }
  50% { height: 50%; }
}

.equipment-gauge {
  position: absolute;
  right: 20%;
  top: 20%;
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(100, 200, 255, 0.4);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(100, 200, 255, 0.1), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.equipment-gauge::after {
  content: '';
  position: absolute;
  width: 60%;
  height: 3rpx;
  background: rgba(100, 200, 255, 0.6);
  animation: gauge-swing 2s ease-in-out infinite;
  transform-origin: left center;
}

@keyframes gauge-swing {
  0%, 100% { transform: rotate(-45deg); }
  50% { transform: rotate(45deg); }
}

.liquid-flow {
  position: absolute;
  right: 20%;
  bottom: 30%;
  width: 200rpx;
  height: 400rpx;
}

.liquid-stream {
  position: absolute;
  width: 20rpx;
  height: 100%;
  left: 50%;
