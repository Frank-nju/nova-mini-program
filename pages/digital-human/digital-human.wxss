.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0A0A0F;
  color: #e0e0e0;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #16213e, #0f3460);
  border-bottom: 2rpx solid #e94560;
}

.btn-back {
  padding: 10rpx 20rpx;
  color: #a0a0b0;
  font-size: 28rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e94560;
  letter-spacing: 4rpx;
}

.header-placeholder {
  width: 100rpx;
}

/* 聊天容器 */
.chat-container {
  flex: 1;
  padding: 20rpx;
}

.scroll-anchor {
  height: 1rpx;
}

/* 消息气泡 */
.msg {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeIn 0.3s ease;
}

.msg-user {
  justify-content: flex-end;
}

.msg-user .msg-content {
  background: #0f3460;
  color: #fff;
  border-radius: 24rpx;
  border-bottom-right-radius: 4rpx;
  padding: 20rpx 28rpx;
  max-width: 75%;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.msg-content {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 24rpx;
  border-bottom-left-radius: 4rpx;
  padding: 20rpx 28rpx;
  max-width: 75%;
}

.msg-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #e94560;
  margin-bottom: 8rpx;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}

/* 加载指示器 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e94560;
  animation: blink 1.4s infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* 检索信息 */
.retrieval-info {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #2a2a4a;
  font-size: 22rpx;
  color: #808090;
}

/* 语音按钮 */
.audio-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #2a2a4a;
  background: transparent;
  color: #a0a0b0;
  font-size: 24rpx;
}

.audio-btn.playing {
  border-color: #e94560;
  color: #e94560;
  background: rgba(233, 69, 96, 0.1);
}

/* 预设问题 */
.presets-container {
  padding: 16rpx 20rpx;
  background: #0A0A0F;
}

.presets-scroll {
  white-space: nowrap;
}

.presets-list {
  display: inline-flex;
  gap: 12rpx;
}

.preset-btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid #2a2a4a;
  background: transparent;
  color: #a0a0b0;
  font-size: 24rpx;
  white-space: nowrap;
}

.preset-btn:active {
  border-color: #e94560;
  color: #e94560;
}

/* 输入区域 */
.input-area {
  padding: 20rpx 30rpx 40rpx;
  background: #0A0A0F;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-field {
  flex: 1;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  border: 1rpx solid #2a2a4a;
  background: #16213e;
  color: #e0e0e0;
  font-size: 28rpx;
}

.send-btn {
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  background: #e94560;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.send-btn.disabled {
  background: #404060;
}

.send-btn:active {
  opacity: 0.8;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes blink {
  0%, 80%, 100% {
    opacity: 0.3;
  }
  40% {
    opacity: 1;
  }
}
