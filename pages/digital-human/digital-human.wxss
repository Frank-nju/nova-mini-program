/* 全屏页面 */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #0A0A0F;
}

/* 全屏数字人背景 */
.digital-human-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
}

.digital-human-bg digital-human {
  width: 100%;
  height: 100%;
}

/* 顶部标题栏（透明悬浮） */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
  background: linear-gradient(180deg, rgba(10, 10, 15, 0.9) 0%, rgba(10, 10, 15, 0) 100%);
  z-index: 100;
}

.btn-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 32rpx;
  backdrop-filter: blur(10rpx);
}

.btn-back text {
  font-size: 32rpx;
  color: #fff;
}

.header-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.header-placeholder {
  width: 64rpx;
}

/* 聊天消息区域（上半部分，避开面部） */
.chat-container {
  position: fixed;
  top: 120rpx;
  left: 0;
  right: 0;
  height: 45vh;
  z-index: 10;
  padding: 0 24rpx;
}

/* 消息样式 */
.msg {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-user {
  justify-content: flex-end;
}

.msg-ai {
  justify-content: flex-start;
}

/* 半透明消息气泡 */
.msg-content {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(20rpx);
  position: relative;
}

.msg-user .msg-content {
  background: rgba(30, 58, 95, 0.85);
  border: 1rpx solid rgba(100, 180, 255, 0.2);
}

.msg-ai .msg-content {
  background: rgba(30, 30, 45, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.95);
}

/* 加载动画 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: rgba(100, 180, 255, 0.6);
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-10rpx); }
}

/* 音频播放按钮 */
.audio-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-top: 16rpx;
  background: rgba(100, 180, 255, 0.2);
  border-radius: 28rpx;
  border: 1rpx solid rgba(100, 180, 255, 0.3);
}

.audio-btn.playing {
  background: rgba(100, 180, 255, 0.4);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.audio-btn text {
  font-size: 24rpx;
  color: #64b4ff;
}

/* 底部区域（输入+预设问题） */
.bottom-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, rgba(10, 10, 15, 0.95) 0%, rgba(10, 10, 15, 0.7) 60%, transparent 100%);
  z-index: 100;
}

/* 预设问题 */
.presets-container {
  margin-bottom: 20rpx;
}

.presets-scroll {
  white-space: nowrap;
}

.presets-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}

.preset-btn {
  display: inline-flex;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 32rpx;
  backdrop-filter: blur(10rpx);
}

.preset-btn text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

.preset-btn:active {
  background: rgba(100, 180, 255, 0.15);
  border-color: rgba(100, 180, 255, 0.3);
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(30, 30, 45, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 48rpx;
  backdrop-filter: blur(20rpx);
}

.input-field {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #fff;
  background: transparent;
}

.input-field::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.send-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #1e3a5f, #0f2847);
  border-radius: 32rpx;
}

.send-btn.disabled {
  opacity: 0.5;
}

.send-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 滚动锚点 */
.scroll-anchor {
  height: 40rpx;
}
