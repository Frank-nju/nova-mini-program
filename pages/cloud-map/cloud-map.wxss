.cloud-map-page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, rgba(5, 10, 30, 1) 0%, rgba(20, 10, 40, 1) 100%);
  overflow: hidden;
}

/* === 顶部导航栏 === */
.nav-bar {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(10, 10, 15, 0.95);
  border-bottom: 2rpx solid rgba(100, 200, 255, 0.2);
  backdrop-filter: blur(20px);
  box-shadow: 0 2px 20rpx rgba(100, 200, 255, 0.1);
  z-index: 100;
}

.nav-left, .nav-right {
  flex: 1;
}

.nav-left {
  color: #64c8ff;
  font-size: 28rpx;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.nav-left:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.nav-title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* === Canvas 容器 === */
.canvas-container {
  flex: 1;
  position: relative;
  overflow: hidden;
  background: 
    radial-gradient(circle at 30% 40%, rgba(100, 200, 255, 0.05) 0%, transparent 50%),
    radial-gradient(circle at 70% 60%, rgba(255, 100, 150, 0.05) 0%, transparent 50%),
    linear-gradient(to bottom, rgba(20, 20, 50, 0.8), rgba(10, 30, 50, 0.9));
}

.star-canvas {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}

.star-canvas:active {
  cursor: grabbing;
}

/* === 节点信息面板 === */
.node-info-panel {
  position: absolute;
  min-width: 280rpx;
  background: rgba(10, 10, 15, 0.95);
  border: 2rpx solid rgba(100, 200, 255, 0.5);
  border-radius: 16rpx;
  padding: 24rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 8px 32rpx rgba(100, 200, 255, 0.2);
  animation: panel-fade-in 0.3s ease-out;
  z-index: 50;
  pointer-events: all;
}

@keyframes panel-fade-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  word-break: break-word;
}

.info-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #aaa;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-shadow: 0 0 12rpx currentColor;
}

.status-indicator.unlocked {
  opacity: 1;
  filter: drop-shadow(0 0 8rpx rgba(100, 200, 255, 0.6));
}

.status-indicator.locked {
  opacity: 0.3;
}

.info-action {
  margin-top: 16rpx;
}

.btn-enter {
  width: 100%;
  padding: 16rpx;
  background: linear-gradient(135deg, #64c8ff 0%, #3da8d8 100%);
  color: #000;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12rpx rgba(100, 200, 255, 0.3);
}

.btn-enter:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.info-locked {
  padding: 16rpx;
  background: rgba(100, 100, 120, 0.2);
  border-radius: 8rpx;
  color: #aaa;
  font-size: 24rpx;
  text-align: center;
}

/* === 图例栏 === */
.legend-bar {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 32rpx;
  background: rgba(10, 10, 15, 0.95);
  border-top: 2rpx solid rgba(100, 200, 255, 0.2);
  backdrop-filter: blur(20px);
  z-index: 99;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #aaa;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot.unlocked {
  background: #64c8ff;
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.6);
}

.legend-dot.locked {
  background: rgba(100, 100, 120, 0.3);
}

.zoom-tip {
  font-size: 22rpx;
  color: #888;
  letter-spacing: 1rpx;
}

/* === 浮窗控制 === */
.floating-controls {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 90;
}

.float-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(100, 200, 255, 0.8) 0%, rgba(60, 170, 215, 0.8) 100%);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16rpx rgba(100, 200, 255, 0.3);
  transition: all 0.3s ease;
  cursor: pointer;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.float-btn:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.float-btn.reset {
  background: linear-gradient(135deg, rgba(255, 150, 100, 0.8) 0%, rgba(230, 120, 80, 0.8) 100%);
  font-size: 32rpx;
}
