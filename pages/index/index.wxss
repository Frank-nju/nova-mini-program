.page {
  width: 100%;
  height: 100vh;
  background: #0a0a12;
  position: relative;
  overflow: hidden;
}

/* === 深空背景 === */
.deep-space {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(10, 5, 25, 0.95) 0%,
    rgba(15, 8, 35, 0.9) 40%,
    rgba(20, 15, 40, 0.85) 100%
  );
  z-index: 0;
}

/* === 粒子背景（增强版） === */
.background-particles {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 3rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.8);
  animation: float-up 10s linear infinite;
}

.particle:nth-child(3n+1) {
  background: rgba(100, 200, 255, 0.7);
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.5);
  animation-duration: 12s;
}

.particle:nth-child(3n+2) {
  background: rgba(201, 169, 110, 0.6);
  box-shadow: 0 0 8rpx rgba(201, 169, 110, 0.4);
  animation-duration: 14s;
}

.particle:nth-child(5n) {
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 215, 0, 0.5);
  box-shadow: 0 0 12rpx rgba(255, 215, 0, 0.4);
  animation-duration: 16s;
}

@keyframes float-up {
  0% {
    transform: translateY(100vh) translateX(0) scale(0.5);
    opacity: 0;
  }
  10% { opacity: 1; }
  50% { transform: translateY(-40vh) translateX(40rpx) scale(1); }
  90% { opacity: 0.6; }
  100% {
    transform: translateY(-100vh) translateX(80rpx) scale(0.3);
    opacity: 0;
  }
}

/* === 跳过按钮 === */
.skip-btn {
  position: absolute;
  top: 180rpx;
  right: 40rpx;
  z-index: 100;
  padding: 14rpx 36rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.4);
  border-radius: 40rpx;
  background: rgba(10, 10, 18, 0.6);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.skip-btn text {
  font-size: 26rpx;
  color: #c9a96e;
  letter-spacing: 4rpx;
}

.skip-btn:active {
  transform: scale(0.95);
  background: rgba(201, 169, 110, 0.15);
}

/* === 轮播容器 === */
.guide-swiper {
  position: relative;
  z-index: 10;
  width: 100%;
  height: 100vh;
}

.guide-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* === 通用页面容器 === */
.page-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 50rpx;
  box-sizing: border-box;
}

/* === 滑动提示 === */
.swipe-hint {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 30rpx 0 10rpx;
}

.swipe-hint-text {
  font-size: 24rpx;
  color: #5a6a5f;
  letter-spacing: 6rpx;
  opacity: 0.7;
  animation: hint-pulse 2s ease-in-out infinite;
}

.swipe-arrow {
  font-size: 32rpx;
  color: #c9a96e;
  opacity: 0.7;
  animation: hint-arrow-bounce 2s ease-in-out infinite;
}

@keyframes hint-pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

@keyframes hint-arrow-bounce {
  0%, 100% { transform: translateX(0); opacity: 0.4; }
  50% { transform: translateX(10rpx); opacity: 0.8; }
}

/* ========== 第1页：内容均匀分布在10%-90% ========== */

.page1-container {
  justify-content: space-between;
}

.page1-title {
  font-size: 80rpx;
}

.page1-container .desc-block {
  gap: 20rpx;
}

/* ========== 通用行边框角标 ========== */

/* === 页面图标 === */
.page-icon {
  font-size: 44rpx;
  color: #c9a96e;
  text-shadow: 0 0 40rpx rgba(201, 169, 110, 0.6), 0 0 80rpx rgba(201, 169, 110, 0.3);
  animation: icon-glow 3s ease-in-out infinite alternate;
  margin-bottom: 16rpx;
}

@keyframes icon-glow {
  from { text-shadow: 0 0 40rpx rgba(201, 169, 110, 0.4); transform: scale(1); }
  to { text-shadow: 0 0 60rpx rgba(201, 169, 110, 0.8), 0 0 120rpx rgba(201, 169, 110, 0.4); transform: scale(1.1); }
}

/* === 主标题 === */
.page-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #f0e6d2;
  letter-spacing: 10rpx;
  text-shadow: 0 0 40rpx rgba(100, 180, 255, 0.3);
  line-height: 1;
}

.page-subtitle {
  font-size: 40rpx;
  font-weight: 600;
  color: #c9a96e;
  letter-spacing: 6rpx;
  text-shadow: 0 0 30rpx rgba(201, 169, 110, 0.4);
  margin-top: 8rpx;
}

/* === 分隔线 === */
.divider-line {
  width: 120rpx;
  height: 2rpx;
  margin: 28rpx 0;
  background: linear-gradient(90deg, transparent, #c9a96e, transparent);
  animation: line-shimmer 2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes line-shimmer {
  0%, 100% { opacity: 0.6; transform: scaleX(1); }
  50% { opacity: 1; transform: scaleX(1.2); }
}

/* === 描述文本 === */
.desc-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: center;
}

.desc-text {
  font-size: 26rpx;
  color: #9aaa9f;
  letter-spacing: 3rpx;
  line-height: 1.8;
  text-align: center;
}

/* === 团队徽章 === */
.team-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 30rpx 60rpx;
  border: 1rpx solid rgba(201, 169, 110, 0.3);
  border-radius: 20rpx;
  background: rgba(201, 169, 110, 0.05);
  animation: team-border-glow 4s ease-in-out infinite alternate;
}

@keyframes team-border-glow {
  from { border-color: rgba(201, 169, 110, 0.2); box-shadow: 0 0 20rpx rgba(201, 169, 110, 0.1); }
  to { border-color: rgba(201, 169, 110, 0.5); box-shadow: 0 0 40rpx rgba(201, 169, 110, 0.3); }
}

.team-label {
  font-size: 22rpx;
  color: #5a6a5f;
  letter-spacing: 6rpx;
}

.team-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #c9a96e;
  letter-spacing: 6rpx;
  text-shadow: 0 0 20rpx rgba(201, 169, 110, 0.4);
}

.team-tag {
  font-size: 22rpx;
  color: #64c8ff;
  letter-spacing: 4rpx;
  opacity: 0.7;
}

/* === 页码指示器 === */
.page-indicators {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  display: flex;
  gap: 18rpx;
}

.indicator {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(201, 169, 110, 0.3);
  border: 1rpx solid rgba(201, 169, 110, 0.4);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.indicator.active {
  width: 36rpx;
  border-radius: 8rpx;
  background: #c9a96e;
  box-shadow: 0 0 16rpx rgba(201, 169, 110, 0.6);
}

/* ========== 第1页：内容均匀分布在10%-90% ========== */

.page1-container {
  justify-content: space-between;
}

.page1-title {
  font-size: 80rpx;
}

.page1-container .desc-block {
  gap: 20rpx;
}

/* ========== 通用行边框角标 ========== */

.row-corner {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
}

.row-corner::before,
.row-corner::after {
  content: '';
  position: absolute;
  background: rgba(201, 169, 110, 0.7);
}

.row-corner.tl {
  top: -1rpx;
  left: -1rpx;
}
.row-corner.tl::before {
  width: 24rpx;
  height: 2rpx;
  top: 0; left: 0;
}
.row-corner.tl::after {
  width: 2rpx;
  height: 24rpx;
  top: 0; left: 0;
}

.row-corner.tr {
  top: -1rpx;
  right: -1rpx;
}
.row-corner.tr::before {
  width: 24rpx;
  height: 2rpx;
  top: 0; right: 0;
}
.row-corner.tr::after {
  width: 2rpx;
  height: 24rpx;
  top: 0; right: 0;
}

.row-corner.bl {
  bottom: -1rpx;
  left: -1rpx;
}
.row-corner.bl::before {
  width: 24rpx;
  height: 2rpx;
  bottom: 0; left: 0;
}
.row-corner.bl::after {
  width: 2rpx;
  height: 24rpx;
  bottom: 0; left: 0;
}

.row-corner.br {
  bottom: -1rpx;
  right: -1rpx;
}
.row-corner.br::before {
  width: 24rpx;
  height: 2rpx;
  bottom: 0; right: 0;
}
.row-corner.br::after {
  width: 2rpx;
  height: 24rpx;
  bottom: 0; right: 0;
}

/* ========== 第2页：展区纵向列表 ========== */

.page2-container {
  justify-content: space-evenly;
  padding-top: 260rpx;
}

.page2-title {
  font-size: 56rpx;
}

.exhibit-list {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 12rpx;
  padding: 40rpx 0;
  position: relative;
}

/* 顶部虚化渐变 */
.exhibit-list-fade {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 2;
  pointer-events: none;
}
.exhibit-list-fade-top {
  top: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, #0a0a12, transparent);
}
.exhibit-list-fade-bottom {
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(to top, #0a0a12, transparent);
}

.exhibit-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 36rpx 0 30rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(20, 15, 40, 0.85) 0%, rgba(30, 25, 50, 0.75) 100%);
  border: 1rpx solid rgba(201, 169, 110, 0.15);
  gap: 24rpx;
  transition: all 0.3s ease;
  transform: translateX(0);
}

/* 交错布局：偶数行向右偏移 */
.exhibit-row-stagger-right {
  transform: translateX(36rpx);
}

/* 各行不同颜色的左边框 */
.exhibit-row-1 { border-left: 3rpx solid rgba(100, 200, 255, 0.6); }
.exhibit-row-2 { border-left: 3rpx solid rgba(255, 215, 0, 0.6); }
.exhibit-row-3 { border-left: 3rpx solid rgba(255, 105, 180, 0.6); }
.exhibit-row-4 { border-left: 3rpx solid rgba(255, 170, 0, 0.6); }
.exhibit-row-5 { border-left: 3rpx solid rgba(32, 178, 170, 0.6); }
.exhibit-row-6 { border-left: 3rpx solid rgba(201, 169, 110, 0.6); }

.row-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #c9a96e;
  opacity: 0.5;
  flex-shrink: 0;
  width: 60rpx;
  text-align: center;
}

.row-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0e6d2;
  letter-spacing: 4rpx;
}

.row-subtitle {
  font-size: 22rpx;
  color: #9aaa9f;
  letter-spacing: 3rpx;
  opacity: 0.7;
}

/* ========== 第3页：功能纵向列表 ========== */

.page3-container {
  justify-content: space-evenly;
  padding-top: 260rpx;
}

.page3-title {
  font-size: 56rpx;
}

.feature-list {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  gap: 12rpx;
  padding: 40rpx 0;
  position: relative;
}

/* 顶部虚化渐变 */
.feature-list-fade {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 2;
  pointer-events: none;
}
.feature-list-fade-top {
  top: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, #0a0a12, transparent);
}
.feature-list-fade-bottom {
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(to top, #0a0a12, transparent);
}

.feature-row {
  position: relative;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 36rpx 0 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(20, 15, 40, 0.85) 0%, rgba(30, 25, 50, 0.75) 100%);
  border: 1rpx solid rgba(100, 200, 255, 0.12);
  gap: 24rpx;
  transform: translateX(0);
}

/* 交错布局：偶数行向右偏移 */
.feature-row-stagger-right {
  transform: translateX(36rpx);
}

.feature-row-1 { border-left: 3rpx solid rgba(100, 200, 255, 0.6); }
.feature-row-2 { border-left: 3rpx solid rgba(255, 215, 0, 0.6); }
.feature-row-3 { border-left: 3rpx solid rgba(201, 169, 110, 0.6); }
.feature-row-4 { border-left: 3rpx solid rgba(255, 105, 180, 0.6); }
.feature-row-5 { border-left: 3rpx solid rgba(0, 255, 0, 0.5); }

.feature-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  background: rgba(100, 200, 255, 0.12);
  color: #64c8ff;
  text-shadow: 0 0 10rpx rgba(100, 200, 255, 0.5);
}

.feature-row-2 .feature-icon-wrap { background: rgba(255, 215, 0, 0.12); color: #ffd700; text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.5); }
.feature-row-3 .feature-icon-wrap { background: rgba(201, 169, 110, 0.12); color: #c9a96e; text-shadow: 0 0 10rpx rgba(201, 169, 110, 0.5); }
.feature-row-4 .feature-icon-wrap { background: rgba(255, 105, 180, 0.12); color: #ff69b4; text-shadow: 0 0 10rpx rgba(255, 105, 180, 0.5); }
.feature-row-5 .feature-icon-wrap { background: rgba(0, 255, 0, 0.08); color: #00ff00; text-shadow: 0 0 10rpx rgba(0, 255, 0, 0.5); }

.feature-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #f0e6d2;
  letter-spacing: 3rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #9aaa9f;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

/* ========== 第4页：启程 ========== */

.page4-container {
  justify-content: center;
  gap: 20rpx;
}

.page4-title {
  font-size: 56rpx;
}

.page4-subtitle {
  font-size: 32rpx;
  color: #64c8ff;
  text-shadow: 0 0 30rpx rgba(100, 200, 255, 0.5);
  margin-top: 4rpx;
}

.page4-container .divider-line {
  margin: 72rpx 0;
}

.page4-container .desc-block {
  gap: 36rpx;
}

.page4-container .desc-text {
  font-size: 24rpx;
}

.btn-enter {
  padding: 24rpx 80rpx;
  height: auto;
  line-height: 1;
  background: linear-gradient(135deg, rgba(100, 180, 255, 0.9) 0%, rgba(70, 150, 220, 0.8) 100%);
  color: #0a0a12;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 60rpx;
  border: 2rpx solid rgba(150, 220, 255, 0.6);
  box-shadow: 0 0 60rpx rgba(100, 180, 255, 0.5), 0 0 120rpx rgba(100, 180, 255, 0.2);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: btn-pulse 2s ease-in-out infinite;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  white-space: nowrap;
}

.btn-enter::after {
  border: none;
}

.btn-enter:active {
  transform: scale(0.95);
  box-shadow: 0 0 80rpx rgba(100, 180, 255, 0.7);
}

.btn-enter-text {
  white-space: nowrap;
  letter-spacing: 8rpx;
}

@keyframes btn-pulse {
  0%, 100% { box-shadow: 0 0 60rpx rgba(100, 180, 255, 0.5), 0 0 120rpx rgba(100, 180, 255, 0.2); }
  50% { box-shadow: 0 0 80rpx rgba(100, 180, 255, 0.7), 0 0 160rpx rgba(100, 180, 255, 0.3); }
}
