.page {
  min-height: 100vh;
  background: #0A0A0F;
  color: #fff;
}

.header {
  display: flex;
  align-items: center;
  padding: 40rpx 24rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.btn-back {
  font-size: 36rpx;
  padding: 10rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
}

.content {
  padding: 40rpx 24rpx;
}

.input-area {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 40rpx;
  color: #fff;
}

.send-btn {
  padding: 0 40rpx;
  height: 80rpx;
  background: #1e3a5f;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
}

.send-btn.disabled {
  opacity: 0.5;
}

.result {
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 30rpx;
}

.section {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  color: rgba(255,255,255,0.6);
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
}

.audio-btn {
  display: inline-flex;
  padding: 20rpx 40rpx;
  background: rgba(100,180,255,0.2);
  border-radius: 40rpx;
}

.audio-btn.playing {
  background: rgba(100,180,255,0.4);
}
