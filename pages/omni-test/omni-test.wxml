<view class="page">
  <view class="header">
    <view class="btn-back" bindtap="goBack">←</view>
    <text class="title">Omni 测试</text>
  </view>

  <view class="content">
    <view class="input-area">
      <input class="input" value="{{question}}" bindinput="onInput" placeholder="输入问题..." />
      <view class="send-btn {{loading ? 'disabled' : ''}}" bindtap="send">
        <text>{{loading ? '生成中...' : '发送'}}</text>
      </view>
    </view>

    <view class="result" wx:if="{{text}}">
      <view class="section">
        <text class="label">文字回复：</text>
        <text class="text">{{text}}</text>
      </view>
      
      <view class="section" wx:if="{{audioUrl}}">
        <text class="label">语音：</text>
        <view class="audio-btn {{playing ? 'playing' : ''}}" bindtap="playAudio">
          <text>{{playing ? '⏸ 停止' : '▶ 播放'}}</text>
        </view>
      </view>

      <view class="section">
        <text class="label">耗时：{{duration}}ms</text>
      </view>
    </view>
  </view>
</view>
