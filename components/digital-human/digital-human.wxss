.dh-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #0A0A0F 0%, #0F1520 50%, #0A0A0F 100%);
}

.dh-base {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: auto;
  object-fit: contain;
}

.dh-mouth-window {
  position: absolute;
  overflow: hidden;
  border-radius: 50%;
}

.dh-mouth-img {
  position: absolute;
  object-fit: cover;
}

.dh-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  background: rgba(100, 180, 255, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #64b4ff;
}
