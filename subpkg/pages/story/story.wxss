}

.story-container[data-section="3"] {
  background: linear-gradient(135deg, rgba(20, 15, 10, 0.95) 0%, rgba(15, 12, 8, 0.9) 100%);
}

.story-container[data-section="4"] {
  background: linear-gradient(135deg, rgba(10, 25, 35, 0.95) 0%, rgba(15, 20, 35, 0.9) 100%);
}

.story-container[data-section="5"] {
  background: linear-gradient(135deg, rgba(25, 15, 10, 0.95) 0%, rgba(20, 10, 5, 0.9) 100%);
}

/* ============================================
   新增：序章暗到亮过渡覆盖层
   ============================================ */
.chapter-overlay {
  position: fixed;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(10, 10, 15, 0.95), rgba(0, 0, 0, 0.99));
  z-index: 2;
  pointer-events: none;
  transition: opacity 1.5s ease;
}

/* ============================================
   新增：序章古籍风格开场卡片 + 红色印章
   ============================================ */
.bio-opening-card {
  background: linear-gradient(160deg, #2a2520 0%, #1a1815 50%, #2a2520 100%);
  border: 2rpx solid rgba(201, 169, 110, 0.3);
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-shadow: inset 0 0 60rpx rgba(0, 0, 0, 0.5), 0 0 30rpx rgba(201, 169, 110, 0.1);
  position: relative;
  overflow: visible;
}

.bio-opening-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 80rpx,
    rgba(201, 169, 110, 0.03) 80rpx,
    rgba(201, 169, 110, 0.03) 81rpx
  );
  pointer-events: none;
}

.bio-opening-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c9a96e 30%, #c9a96e 70%, transparent);
  pointer-events: none;
}

.bio-opening-card .bio-year {
  color: rgba(201, 169, 110, 0.2);
}

.bio-opening-card .bio-title {
  color: #f0ede6;
}

.bio-opening-card .bio-text text {
  color: #c8c0b0;
}

/* 红色印章 */
.bio-stamp {
  position: absolute;
  top: 24rpx;
  left: 28rpx;
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid rgba(192, 60, 60, 0.6);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(-5deg);
  background: rgba(192, 60, 60, 0.08);
}

.stamp-char {
  font-size: 36rpx;
  color: rgba(192, 60, 60, 0.7);
  font-weight: 700;
  line-height: 1;
}

.stamp-label {
  font-size: 16rpx;
  color: rgba(192, 60, 60, 0.5);
  line-height: 1;
  margin-top: 4rpx;
}

/* ============================================
   新增：时间线多色渐变轴线
   ============================================ */
.timeline-line {
  background: linear-gradient(
    to bottom,
    transparent,
    #64c8ff 10%,
    #8b7db8 30%,
    #c9a96e 50%,
    #ff69b4 70%,
    #20b2aa 90%,
    transparent
  ) !important;
}

/* 时间线图标 */
.tl-icon {
  font-size: 28rpx;
  display: inline-block;
  margin-right: 8rpx;
  vertical-align: middle;
  filter: drop-shadow(0 0 4rpx rgba(255, 255, 255, 0.2));
}

.tl-year {
  display: flex;
  align-items: center;
}

/* 浮动年份导航条 */
.timeline-float-nav {
  position: absolute;
  right: -8rpx;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  z-index: 5;
  gap: 8rpx;
}

.tf-nav-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  transition: all 0.3s ease;
  background: rgba(10, 10, 15, 0.7);
  border: 1rpx solid rgba(201, 169, 110, 0.1);
}

.tf-nav-year {
  font-size: 20rpx;
  color: rgba(201, 169, 110, 0.5);
  font-weight: 500;
}

.tf-nav-item.tf-nav-active {
  background: rgba(201, 169, 110, 0.25);
  border-color: rgba(201, 169, 110, 0.5);
  box-shadow: 0 0 12rpx rgba(201, 169, 110, 0.2);
}

.tf-nav-item.tf-nav-active .tf-nav-year {
  color: #c9a96e;
  font-weight: 700;
}

.tf-nav-item.tf-nav-complete {
  background: rgba(201, 169, 110, 0.1);
  border-color: rgba(201, 169, 110, 0.2);
}

.tf-nav-item.tf-nav-complete .tf-nav-year {
  color: rgba(201, 169, 110, 0.7);
}

.tf-nav-item:active {
  transform: scale(0.9);
}

/* ============================================
   新增：科研固定 Canvas
   ============================================ */
.research-fixed-visual {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  height: 290rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  pointer-events: none;
}

.experiment-visual-fixed {
  width: 90%;
  max-width: 680rpx;
  height: 270rpx;
  background: rgba(0, 0, 0, 0.6);
  border: 1rpx solid rgba(100, 200, 255, 0.2);
  border-radius: 16rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.5), 0 0 80rpx rgba(100, 200, 255, 0.05);
  position: relative;
  overflow: hidden;
  transition: opacity 0.4s ease;
  pointer-events: none;
}

.experiment-visual-fixed .experiment-canvas {
  width: 100%;
  height: 100%;
}

.experiment-visual-fixed .exp-canvas-label {
  position: absolute;
  bottom: 12rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: rgba(201, 169, 110, 0.6);
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 8rpx;
  z-index: 10;
}

/* Canvas 底部渐变遮罩，与内容区自然衔接 */
.experiment-visual-fixed::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.4));
  pointer-events: none;
}

/* ============================================
   新增：尾声动态背景过渡
   ============================================ */
.epilogue-dynamic-bg {
  transition: background 1.2s ease;
}

/* ============================================
   尾声 6 阶段场景装饰层
   ============================================ */

/* Stage 0: 黄昏 — 顶部橙色光晕 */
.epi-scene-decor {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  transition: opacity 1.2s ease;
}

.epi-scene-0 {
  background: radial-gradient(ellipse at 50% 10%, rgba(255, 140, 66, 0.15) 0%, transparent 60%);
}

/* Stage 1: 暮色 — 左右紫色光线条 */
.epi-scene-1 {
  background: linear-gradient(90deg, rgba(201, 125, 184, 0.08) 0%, transparent 15%, transparent 85%, rgba(201, 125, 184, 0.08) 100%);
  animation: epi-purple-pulse 4s ease-in-out infinite;
}

@keyframes epi-purple-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* Stage 2: 夜色 — 底部蓝色水波纹 */
.epi-scene-2::after {
  content: '';
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(100, 136, 200, 0.06) 25%,
    rgba(100, 136, 200, 0.1) 50%,
    rgba(100, 136, 200, 0.06) 75%,
    transparent 100%
  );
  animation: epi-water-wave 6s ease-in-out infinite;
}

@keyframes epi-water-wave {
  0%, 100% { transform: translateX(-5%); opacity: 0.5; }
  50% { transform: translateX(5%); opacity: 0.8; }
}

/* Stage 3: 深夜 — 中间暖色分隔线（曙光） */
.epi-scene-3::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 10%;
  right: 10%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 200, 120, 0.4), transparent);
  animation: epi-dawn-glow 3s ease-in-out infinite;
}

@keyframes epi-dawn-glow {
  0%, 100% { opacity: 0.4; width: 60%; left: 20%; }
  50% { opacity: 0.8; width: 80%; left: 10%; }
}

/* Stage 4: 最后坚守 — 金色呼吸光点（烛光） */
.epi-scene-4 {
  background: radial-gradient(circle at 50% 40%, rgba(255, 215, 0, 0.1) 0%, transparent 30%);
  animation: epi-candle 2.5s ease-in-out infinite;
}

@keyframes epi-candle {
  0%, 100% { opacity: 0.5; }
  25% { opacity: 0.8; }
  50% { opacity: 0.6; }
  75% { opacity: 0.9; }
}

/* Stage 5: 星空永恒 — 深空背景 + 微弱星光 */
.epi-scene-5 {
  background: radial-gradient(circle at 30% 20%, rgba(100, 200, 255, 0.05) 0%, transparent 40%),
              radial-gradient(circle at 70% 80%, rgba(255, 215, 0, 0.05) 0%, transparent 40%);
}

/* ============================================
   新增：星空粒子层（尾声最终故事）
   ============================================ */
.starfield-overlay {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  animation: starfield-fade-in 2s ease forwards;
}

@keyframes starfield-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.star {
  position: absolute;
  width: 2rpx;
  height: 2rpx;
  background: #fff;
  border-radius: 50%;
  animation: star-twinkle 2s ease-in-out infinite alternate;
}

.star:nth-child(3n) {
  width: 4rpx;
  height: 4rpx;
  background: #ffd700;
  box-shadow: 0 0 6rpx rgba(255, 215, 0, 0.5);
}

.star:nth-child(5n) {
  width: 3rpx;
  height: 3rpx;
  background: #64c8ff;
  box-shadow: 0 0 8rpx rgba(100, 200, 255, 0.4);
}

@keyframes star-twinkle {
  from { opacity: 0.3; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1.2); }
}

/* 流星 */
.shooting-star {
  position: absolute;
  top: 15%;
  left: 20%;
  width: 2rpx;
  height: 2rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 6rpx 2rpx rgba(255, 255, 255, 0.6);
  animation: shooting-star 8s linear infinite;
  animation-delay: 0s;
}

.shooting-star::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 80rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.6), transparent);
  transform: rotate(-35deg);
  transform-origin: left center;
}

.shooting-star-2 {
  top: 35%;
  left: 60%;
  animation-delay: 4s;
}

@keyframes shooting-star {
  0% { opacity: 0; transform: translate(0, 0); }
  2% { opacity: 1; }
  8% { opacity: 0; transform: translate(-120rpx, 80rpx); }
  100% { opacity: 0; }
}

/* 尾声最后一个故事：结尾寄语金色渐变 */
.epilogue-closing.closing-final .ec-text {
  background: linear-gradient(90deg, #c9a96e, #ffd700, #c9a96e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: #ffd700;
  font-size: 36rpx;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
}

.epilogue-closing.closing-final .ec-line {
  background: linear-gradient(90deg, transparent, #ffd700, transparent);
  height: 3rpx;
}
