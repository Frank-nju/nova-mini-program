<view class="star-page">
  <view class="back-btn" bindtap="goBack">✕</view>

  <canvas type="2d" id="lineCanvas" class="line-canvas"
          bindtouchstart="handleTouchStart"
          bindtouchmove="handleTouchMove"
          bindtouchend="handleTouchEnd"></canvas>

  <!-- 缩放控制按钮 -->
  <view class="zoom-controls">
    <view class="zoom-btn" bindtap="zoomIn">+</view>
    <view class="zoom-btn" bindtap="zoomOut">−</view>
  </view>

  <!-- 调试：重置进度按钮（仅开发/体验版可见） -->
  <view wx:if="{{isDev}}" class="debug-reset-btn" bindtap="debugReset">重置</view>
</view>
