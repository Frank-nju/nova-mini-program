<view class="star-page">
  <view class="back-btn" bindtap="goBack">✕</view>

  <canvas type="2d" id="lineCanvas" class="line-canvas"></canvas>

  <view class="zoom-container"
        bindtouchstart="handleTouchStart"
        bindtouchmove="handleTouchMove"
        bindtouchend="handleTouchEnd"
        style="transform: scale({{mapScale}}) translate({{offsetX}}px, {{offsetY}}px)">

    <view wx:for="{{nodes}}" wx:key="id"
          class="star-node {{item.unlocked ? 'is-lit' : 'is-dark'}} {{item.nodeId === 'node_0' ? 'is-center' : ''}} {{zoomState >= 8 ? 'node-fade-out' : ''}}"
          style="left: {{item.x}}rpx; top: {{item.y}}rpx; {{zoomState >= 8 ? 'pointer-events: none;' : ''}}"
          bindtap="onStarTap" data-id="{{item.id}}">
      <view class="star-core"></view>
      <text class="star-text label-{{zoomState < 7 && (zoomState < 5 || item.nodeId === 'node_0') ? 'show' : 'hide'}}">{{item.title}}</text>
    </view>
  </view>

  <!-- 缩放控制按钮 -->
  <view class="zoom-controls">
    <view class="zoom-btn" bindtap="zoomIn">+</view>
    <view class="zoom-btn" bindtap="zoomOut">−</view>
  </view>

  <!-- 调试：重置进度按钮（仅开发/体验版可见） -->
  <view wx:if="{{isDev}}" class="debug-reset-btn" bindtap="debugReset">重置</view>
</view>

