.star-page {
  width: 100vw;
  height: 100vh;
  background: #000814;
  overflow: hidden;
  position: relative;
}

.back-btn {
  position: fixed;
  top: 30rpx;
  left: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 36rpx;
  z-index: 1000;
  cursor: pointer;
  transition: all 0.3s ease;
}

.back-btn:active {
  color: #44aaff;
  transform: scale(1.2);
}

.zoom-container {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: center;
  transition: transform 0.2s ease;
}

.line-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

/* 星星常驻微弱摇摆动画 */
@keyframes starFloat {
  0% { transform: translate(0, 0); }
  50% { transform: translate(8rpx, 12rpx); }
  100% { transform: translate(0, 0); }
}

/* 点亮星星的呼吸动画 */
@keyframes starBreathe {
  0%, 100% { opacity: 1; box-shadow: 0 0 20rpx #44aaff, 0 0 40rpx #fff; }
  50% { opacity: 0.7; box-shadow: 0 0 15rpx #44aaff, 0 0 30rpx rgba(68, 170, 255, 0.5); }
}

.star-node {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  cursor: pointer;
  transform: translate(-50%, -50%);
  transition: transform 0.3s ease;
}

.star-node:active {
  transform: translate(-50%, -50%) scale(1.3);
}

/* 星星内核 - 灰暗状态 */
.is-dark .star-core {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  transition: all 0.5s ease;
}

.is-dark .star-text {
  color: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  margin-top: 8rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

/* 星星内核 - 点亮状态 */
.is-lit .star-core {
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 20rpx #44aaff, 0 0 40rpx #fff;
  animation: starBreathe 2.5s infinite ease-in-out;
}

.is-lit .star-text {
  color: #fff;
  font-size: 22rpx;
  margin-top: 8rpx;
  white-space: nowrap;
  text-shadow: 0 0 10rpx #44aaff;
}

/* 缩放控制按钮 */
.zoom-controls {
  position: fixed;
  bottom: 60rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  z-index: 1000;
}

.zoom-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #44aaff 0%, #0066cc 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4px 15rpx rgba(68, 170, 255, 0.4);
  transition: all 0.3s ease;
  cursor: pointer;
}

.zoom-btn:active {
  transform: scale(1.1);
  box-shadow: 0 6px 20rpx rgba(68, 170, 255, 0.6);
}

