.star-page {
  width: 100vw;
  height: 100vh;
  background: #000814;
  overflow: hidden;
  position: relative;
}

.back-btn {
  position: fixed;
  top: 30rpx;
  left: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 36rpx;
  z-index: 1000;
  cursor: pointer;
  transition: all 0.3s ease;
}

.back-btn:active {
  color: #44aaff;
  transform: scale(1.2);
}

.line-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ─── 缩放控制按钮 ─── */
.zoom-controls {
  position: fixed;
  bottom: 60rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  z-index: 1000;
}

.zoom-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #44aaff 0%, #0066cc 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4px 15rpx rgba(68, 170, 255, 0.4);
  transition: all 0.3s ease;
  cursor: pointer;
}

.zoom-btn:active {
  transform: scale(1.1);
  box-shadow: 0 6px 20rpx rgba(68, 170, 255, 0.6);
}

/* ─── 调试重置按钮 ─── */
.debug-reset-btn {
  position: fixed;
  bottom: 60rpx;
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b6b 0%, #cc3333 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 4px 15rpx rgba(255, 100, 100, 0.4);
  z-index: 1000;
  cursor: pointer;
}

.debug-reset-btn:active {
  transform: scale(1.1);
  box-shadow: 0 6px 20rpx rgba(255, 100, 100, 0.6);
}
