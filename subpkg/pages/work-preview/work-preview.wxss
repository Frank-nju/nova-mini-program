.preview-page {
  width: 100%;
  height: 100vh;
  background: linear-gradient(180deg, #0a0a12 0%, #0f0f1a 50%, #0a0a12 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.preview-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: rgba(10, 10, 18, 0.95);
  border-bottom: 1rpx solid rgba(201, 169, 110, 0.15);
  flex-shrink: 0;
  z-index: 10;
}

.header-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 169, 110, 0.1);
  border-radius: 50%;
  border: 1rpx solid rgba(201, 169, 110, 0.3);
  margin-right: 20rpx;
}

.back-arrow {
  font-size: 40rpx;
  color: #c9a96e;
  line-height: 1;
}

.header-info {
  flex: 1;
  overflow: hidden;
}

.work-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(240, 230, 210, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.work-author {
  display: block;
  font-size: 26rpx;
  color: rgba(201, 169, 110, 0.75);
  margin-top: 4rpx;
}

/* 内容区 */
.preview-body {
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* 加载/错误 */
.loading-area, .error-area {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: rgba(200, 200, 220, 0.4);
  font-size: 26rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.15);
  border-top-color: rgba(201, 169, 110, 0.6);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.error-icon {
  font-size: 64rpx;
  color: rgba(255, 180, 80, 0.5);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 图片居中区 */
.media-center {
  position: absolute;
  top: 2%;
  left: 2%;
  right: 2%;
  bottom: 2%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 竖屏：宽度撑满左右留边，可滚动查看完整图片 */
.image-scroll {
  width: 100%;
  height: 100%;
}

.image-scroll .media-image {
  width: 100%;
  height: auto;
  display: block;
}

/* 横屏：aspectFit 自适应，填满容器 */
.media-image.landscape {
  width: 100%;
  height: 100%;
}

/* 视频内嵌播放器 */
.video-wrap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
}

.media-video {
  width: 100%;
  height: 100%;
  background: #000;
}

/* ========== 底部评分区 ========== */
.rating-section {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(10, 10, 18, 0.98) 0%, rgba(15, 15, 25, 0.98) 100%);
  border-top: 1rpx solid rgba(201, 169, 110, 0.12);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 第一行：五颗可点击星星 */
.rating-stars-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.rating-star-btn {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
}

.rating-star-btn.full {
  color: #ffd700;
}

.rating-star-btn.empty {
  color: rgba(200, 200, 220, 0.25);
}

.rating-star-btn:active {
  transform: scale(1.2);
  transition: transform 0.15s ease;
}

.rating-star {
  font-size: 60rpx;
  line-height: 60rpx;
}

/* 第二行：左边评分信息 + 右边状态 */
.rating-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rating-info-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rating-score-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffd700;
  line-height: 1;
}

.rating-mini-stars {
  display: flex;
  gap: 2rpx;
}

.rating-mini-star-wrapper {
  display: flex;
  width: 20rpx;
  height: 20rpx;
  overflow: hidden;
  position: relative;
  align-items: center;
  justify-content: center;
}

.rating-mini-star-wrapper.full {
  color: #ffd700;
}

.rating-mini-star-wrapper.half .rating-mini-star {
  position: absolute;
  left: 0;
  top: 0;
  color: #ffd700;
  width: 50%;
  overflow: hidden;
}

.rating-mini-star-wrapper.empty {
  color: rgba(200, 200, 220, 0.25);
}

.rating-mini-star {
  font-size: 20rpx;
  line-height: 20rpx;
}

.rating-count-text {
  font-size: 20rpx;
  color: rgba(200, 200, 220, 0.5);
}

.rating-none {
  color: rgba(201, 169, 110, 0.5);
}

.rating-status-badge {
  flex-shrink: 0;
  padding: 10rpx 36rpx;
  background: rgba(201, 169, 110, 0.08);
  border: 1rpx solid rgba(201, 169, 110, 0.25);
  border-radius: 36rpx;
}

.rating-status-badge text {
  font-size: 24rpx;
  color: rgba(201, 169, 110, 0.75);
  white-space: nowrap;
}
