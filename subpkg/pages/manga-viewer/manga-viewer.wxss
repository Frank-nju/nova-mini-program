.manga-viewer-page {
  width: 100%;
  height: 100vh;
  background: #0a0a0f;
  display: flex;
  flex-direction: column;
}

/* 顶部信息栏 */
.manga-header {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: rgba(10, 10, 15, 0.95);
  border-bottom: 1rpx solid rgba(201, 169, 110, 0.2);
  flex-shrink: 0;
}

.header-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(201, 169, 110, 0.1);
  border-radius: 50%;
  border: 1rpx solid rgba(201, 169, 110, 0.3);
  margin-right: 20rpx;
}

.back-arrow {
  font-size: 40rpx;
  color: #c9a96e;
  line-height: 1;
}

.header-info {
  flex: 1;
  overflow: hidden;
}

.manga-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(240, 230, 210, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.manga-author {
  display: block;
  font-size: 26rpx;
  color: rgba(201, 169, 110, 0.75);
  margin-top: 4rpx;
}

/* 漫画浏览区 */
.manga-swiper {
  flex: 1;
  background: #12121e;
}

.manga-swiper-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.manga-page-img {
  max-width: 100%;
  max-height: 100%;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.5);
}

.manga-page-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: rgba(200, 200, 220, 0.4);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(201, 169, 110, 0.15);
  border-top-color: rgba(201, 169, 110, 0.6);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.manga-page-indicator {
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: rgba(201, 169, 110, 0.6);
  background: rgba(10, 10, 15, 0.95);
  flex-shrink: 0;
  border-top: 1rpx solid rgba(201, 169, 110, 0.15);
}
