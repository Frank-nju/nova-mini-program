page {
  background: #08080f;
}

.lab-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: radial-gradient(ellipse at 50% 0%, rgba(30, 20, 60, 0.6) 0%, #08080f 60%);
  overflow: hidden;
}

.lab-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ===== 顶部步骤条 - 充能进度条 ===== */
.lab-steps-bar {
  position: fixed;
  top: 120rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 100rpx;
  z-index: 100;
  background: linear-gradient(180deg, rgba(8, 8, 15, 0.95) 0%, transparent 100%);
}

.lab-close-btn {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.lab-close-btn text {
  color: #f0ede6;
  font-size: 24rpx;
}

/* 充能进度条样式 */
.lab-steps-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.lab-steps-track {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3rpx;
  overflow: hidden;
}

.lab-steps-fill {
  height: 100%;
  background: linear-gradient(90deg, #64c8ff 0%, #c9a96e 100%);
  border-radius: 3rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 10rpx rgba(100, 200, 255, 0.3);
}

.lab-steps-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ===== 内容叠加层 ===== */
.lab-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx 40rpx;
}

.lab-step-content {
  width: 100%;
  max-width: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.lab-step-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.lab-step-num {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
}

.lab-step-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #f0ede6;
  background: rgba(201, 169, 110, 0.2);
  border: 1rpx solid rgba(201, 169, 110, 0.4);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.lab-tag-cool {
  background: rgba(100, 200, 255, 0.15);
  border-color: rgba(100, 200, 255, 0.4);
  color: #64c8ff;
}

.lab-tag-field {
  background: rgba(255, 105, 180, 0.15);
  border-color: rgba(255, 105, 180, 0.4);
  color: #ff69b4;
}

.lab-tag-observe {
  background: rgba(100, 255, 180, 0.15);
  border-color: rgba(100, 255, 180, 0.4);
  color: #64ffb4;
}

.lab-tag-mirror {
  background: rgba(147, 112, 219, 0.15);
  border-color: rgba(147, 112, 219, 0.4);
  color: #9370db;
}

.lab-tag-reveal {
  background: rgba(255, 215, 0, 0.15);
  border-color: rgba(255, 215, 0, 0.4);
  color: #ffd700;
}

.lab-step-title-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #f0ede6;
  text-align: center;
  text-shadow: 0 0 20rpx rgba(201, 169, 110, 0.3);
}

.lab-step-desc {
  font-size: 26rpx;
  color: rgba(240, 237, 230, 0.6);
  text-align: center;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

/* ===== 信息卡片 - Step 1 专用 ===== */
.lab-info-cards {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-top: 280rpx;
}

.lab-info-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(201, 169, 110, 0.2);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.lab-info-card:active {
  transform: scale(0.98);
  background: rgba(201, 169, 110, 0.1);
}

.lab-info-card-icon {
  font-size: 48rpx;
}

.lab-info-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #c9a96e;
}

.lab-info-card-desc {
  font-size: 22rpx;
  color: rgba(240, 237, 230, 0.5);
  text-align: center;
}

.lab-nucleus-hint {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(100, 200, 255, 0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(100, 200, 255, 0.15);
}

.lab-hint-text {
  font-size: 24rpx;
  color: rgba(100, 200, 255, 0.7);
}


/* ===== Step 2 & 3 布局调整 ===== */
.lab-step-2-layout .lab-step-content,
.lab-step-3-layout .lab-step-content {
  padding-top: 80rpx;
}

.lab-step-2-layout .step-control-panel,
.lab-step-3-layout .step-control-panel {
  margin-top: 200rpx;
}

/* ===== Step 5 & 6 布局调整 ===== */
.lab-step-5-layout .lab-step-content,
.lab-step-6-layout .lab-step-content {
  padding-top: 60rpx;
}

.lab-step-5-layout .step-5-mirror,
.lab-step-6-layout .step-6-reveal {
  margin-top: 280rpx;
}

.lab-temp-panel {
  width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lab-temp-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.lab-temp-number {
  font-size: 72rpx;
  font-weight: 900;
  color: #64c8ff;
  text-shadow: 0 0 30rpx rgba(100, 200, 255, 0.4);
  font-variant-numeric: tabular-nums;
}

.lab-temp-unit {
  font-size: 28rpx;
  color: rgba(100, 200, 255, 0.6);
  margin-top: -10rpx;
}

.lab-temp-label {
  font-size: 24rpx;
  color: rgba(240, 237, 230, 0.5);
  margin-top: 8rpx;
}

.lab-slider {
  width: 100%;
}

.lab-slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
}

/* ===== Step 4: 纯文字布局 ===== */
.lab-step-4-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #08080f;
  z-index: 10;
}

/* 顶部标题区 */
.lab-step4-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 180rpx 30rpx 16rpx;
}

.lab-step4-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #f0ede6;
  text-shadow: 0 0 20rpx rgba(201, 169, 110, 0.3);
  text-align: center;
}

.lab-step4-desc {
  font-size: 24rpx;
  color: rgba(240, 237, 230, 0.5);
  text-align: center;
}

/* 中间视觉区（Canvas） — 已移除 */

.lab-step4-label {
  display: none;
}

/* 下方数据面板 */
.lab-step4-data {
  width: 100%;
  max-width: 680rpx;
  display: flex;
  flex-direction: column;
  padding: 24rpx 30rpx;
  gap: 12rpx;
}

.lab-step4-stats {
  width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(100, 255, 180, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lab-step4-stats-row {
  display: flex;
  justify-content: center;
  gap: 60rpx;
}

.lab-step4-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.lab-step4-stat.active {
  background: rgba(100, 255, 180, 0.08);
}

.lab-step4-stat-arrow {
  font-size: 26rpx;
  font-weight: 700;
  color: #64ffb4;
}

.lab-step4-stat-arrow.down {
  transform: none;
}

.lab-step4-stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #f0ede6;
}

/* 结论说明卡片 */
.lab-step4-result-note {
  width: 100%;
  background: rgba(201, 169, 110, 0.06);
  border: 1rpx solid rgba(201, 169, 110, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.lab-step4-detail-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.lab-step4-detail-text {
  font-size: 28rpx;
  color: rgba(240, 237, 230, 0.75);
  line-height: 1.8;
  text-align: left;
}

.lab-step4-note-text {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(201, 169, 110, 0.85);
  text-align: center;
  line-height: 1.7;
}

/* 底部导航按钮 */
.lab-step4-nav {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}

/* ===== 镜像对比面板 ===== */
.lab-mirror-panel {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lab-mirror-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.lab-mirror-real { border-color: rgba(100, 200, 255, 0.2); }
.lab-mirror-image { border-color: rgba(147, 112, 219, 0.2); }

.lab-mirror-label {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.6);
}

.lab-mirror-result {
  font-size: 32rpx;
  font-weight: 800;
}

.lab-mirror-real .lab-mirror-result { color: #64c8ff; }
.lab-mirror-image .lab-mirror-result { color: #9370db; }

.lab-mirror-divider {
  width: 4rpx;
  height: 200rpx;
  background: linear-gradient(180deg, transparent, rgba(201, 169, 110, 0.4), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lab-mirror-divider-text {
  font-size: 20rpx;
  color: rgba(201, 169, 110, 0.6);
  writing-mode: vertical-lr;
  letter-spacing: 4rpx;
}

/* ===== 揭示面板 ===== */
.lab-reveal-panel {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.lab-reveal-question {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 215, 0, 0.8);
  text-align: center;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.3);
  animation: reveal-question-pulse 2s ease-in-out infinite;
}

@keyframes reveal-question-pulse {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}

/* ===== 导航按钮 ===== */
.lab-step-nav {
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}

.lab-nav-btn {
  padding: 20rpx 36rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.lab-nav-btn:active { transform: scale(0.95); }

.lab-nav-btn text {
  font-size: 28rpx;
  font-weight: 700;
  color: #f0ede6;
}

.lab-nav-prev {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.lab-nav-disabled {
  opacity: 0.4;
}

.lab-nav-next {
  background: linear-gradient(135deg, #9370db 0%, #6a4c93 100%);
  box-shadow: 0 0 20rpx rgba(147, 112, 219, 0.3);
}

.lab-nav-next:not(.lab-nav-disabled) {
  animation: btn-glow 2s ease-in-out infinite;
}

@keyframes btn-glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(147, 112, 219, 0.3); }
  50% { box-shadow: 0 0 30rpx rgba(147, 112, 219, 0.6); }
}

.lab-nav-record {
  flex: 1;
  background: linear-gradient(135deg, #64c8ff 0%, #3a8fbf 100%);
  box-shadow: 0 0 20rpx rgba(100, 200, 255, 0.3);
  animation: btn-record-glow 1.5s ease-in-out infinite;
}

@keyframes btn-record-glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(100, 200, 255, 0.3); }
  50% { box-shadow: 0 0 30rpx rgba(100, 200, 255, 0.6); }
}

.lab-nav-reveal {
  flex: 1;
  background: linear-gradient(135deg, #ffd700 0%, #c9a96e 100%);
  box-shadow: 0 0 25rpx rgba(255, 215, 0, 0.4);
  animation: btn-reveal-glow 1s ease-in-out infinite;
}

.lab-nav-reveal text { color: #1a1028; }

@keyframes btn-reveal-glow {
  0%, 100% { box-shadow: 0 0 25rpx rgba(255, 215, 0, 0.4); }
  50% { box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.7); }
}

/* ===== 序言页 - 全新设计 ===== */
.lab-overlay-intro {
  background: radial-gradient(ellipse at 50% 40%, rgba(30, 20, 60, 0.3) 0%, transparent 60%);
  padding-top: 120rpx;
}

.lab-intro-deco-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  overflow: hidden;
  pointer-events: none;
}

.lab-deco-glow {
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, rgba(201, 169, 110, 0.15) 0%, transparent 70%);
  filter: blur(20rpx);
}

.lab-deco-particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.lab-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(201, 169, 110, 0.6);
  border-radius: 50%;
  animation: particle-float 3s ease-in-out infinite;
}

.lab-particle.p1 { top: 20%; left: 20%; animation-delay: 0s; }
.lab-particle.p2 { top: 30%; right: 25%; animation-delay: 0.5s; }
.lab-particle.p3 { top: 15%; left: 70%; animation-delay: 1s; }
.lab-particle.p4 { top: 40%; right: 15%; animation-delay: 1.5s; }

@keyframes particle-float {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
  50% { transform: translateY(-20rpx) scale(1.2); opacity: 1; }
}

.lab-intro-content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
}

.lab-intro-silhouette {
  width: 140rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  background:
    radial-gradient(ellipse 50rpx 35rpx at 50% 20%, rgba(201, 169, 110, 0.12) 0%, transparent 100%),
    radial-gradient(ellipse 35rpx 55rpx at 50% 40%, rgba(201, 169, 110, 0.1) 0%, transparent 100%),
    radial-gradient(ellipse 70rpx 90rpx at 50% 75%, rgba(201, 169, 110, 0.06) 0%, transparent 100%);
  filter: blur(2rpx);
  animation: silhouette-breathe 4s ease-in-out infinite;
}

.lab-intro-silhouette::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 180rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.3), transparent);
}

@keyframes silhouette-breathe {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.02); }
}

.lab-intro-icons {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.lab-icon-physics {
  font-size: 40rpx;
  color: rgba(201, 169, 110, 0.4);
  font-style: italic;
  animation: icon-pulse 2s ease-in-out infinite;
}

.lab-icon-atom {
  font-size: 56rpx;
  animation: icon-rotate 4s linear infinite;
}

@keyframes icon-pulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.1); }
}

@keyframes icon-rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.lab-intro-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #f0ede6;
  text-shadow: 0 0 30rpx rgba(201, 169, 110, 0.4);
  margin-bottom: 16rpx;
}

.lab-intro-line {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(201, 169, 110, 0.6), transparent);
  margin-bottom: 24rpx;
}

/* 新增信息卡片 */
.lab-intro-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(201, 169, 110, 0.2);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0;
}

.lab-intro-card-year {
  font-size: 48rpx;
  font-weight: 900;
  color: #c9a96e;
  text-shadow: 0 0 20rpx rgba(201, 169, 110, 0.3);
  font-variant-numeric: tabular-nums;
}

.lab-intro-card-text {
  font-size: 28rpx;
  color: rgba(240, 237, 230, 0.8);
  text-align: center;
  line-height: 1.6;
}

.lab-intro-card-formula {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 0;
}

.formula-left, .formula-right {
  font-size: 44rpx;
  font-weight: 700;
  color: #64c8ff;
  font-style: italic;
}

.formula-op {
  font-size: 32rpx;
  color: rgba(240, 237, 230, 0.6);
}

.lab-intro-card-note {
  font-size: 26rpx;
  color: #c9a96e;
  font-weight: 600;
}

.lab-intro-line-text {
  font-size: 28rpx;
  color: rgba(240, 237, 230, 0.7);
  line-height: 1.8;
  text-align: center;
}

.lab-intro-gap {
  height: 24rpx;
}

/* ===== Step 7 结果展示页样式 ===== */
.lab-overlay-result {
  background: radial-gradient(ellipse at 50% 30%, rgba(201, 169, 110, 0.15) 0%, transparent 50%),
              radial-gradient(ellipse at 50% 70%, rgba(100, 200, 255, 0.1) 0%, transparent 40%);
  overflow: hidden;
}

.lab-result-content {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 30rpx;
}

/* 完成标志 */
.lab-result-badge-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.lab-result-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
  color: #fff;
  z-index: 2;
}

.lab-result-badge-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd700 0%, #c9a96e 100%);
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.5), inset 0 0 20rpx rgba(255, 255, 255, 0.3);
  animation: badge-pulse 2s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.5); }
  50% { transform: scale(1.05); box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.7); }
}

.lab-result-main-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffd700;
  text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.5);
}

.lab-result-line {
  width: 150rpx;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.8), transparent);
  margin: 8rpx 0 16rpx;
}

/* 实验结果卡片 */
.lab-result-summary-card {
  width: 100%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 215, 0, 0.05) 100%);
